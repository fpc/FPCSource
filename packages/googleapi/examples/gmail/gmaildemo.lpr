{ Gmail demo: list labels, list the messages with a label or matching a query,
  show a message with its attachments and download an attachment, using the
  Gmail API units generated by discovery2pas and OAuth2 (loopback redirect). }

// Define this if you prefer to use GNU TLS (libgnutls)  
{$ DEFINE USE_GNUTLS}  

program gmaildemo;

{$mode objfpc}{$H+}

uses
  Classes, SysUtils, CustApp, fpjson, jsonparser, fphttpwebclient, 
  {$IFDEF USE_GNUTLS}
  gnutlssockets,
  {$ELSE USE_GNUTLS}
  opensslsockets, 
  {$ENDIF USE_GNUTLS}
  fpoauth2, fpoauth2ini, fpopenapiclient, googleapi.client,
  gmail.Dto, gmail.Serializer, gmail.Service.Intf, gmail.Service.Impl,
  GmailParts, GoogleAPI.OAuthRedirect;

const
  GmailBaseURL = 'https://gmail.googleapis.com';
  GmailScope = 'https://www.googleapis.com/auth/gmail.readonly';
  DefaultPort = 8085;
  DefaultMessageCount = 20;

type
  EGmailDemo = class(Exception);

  { TGmailDemoApplication }

  TGmailDemoApplication = class(TCustomApplication)
  private
    FConfig: String;
    FCredentials: String;
    FSession: String;
    FLogFile: String;
    FPort: Word;
    FManual: Boolean;
    FClient: TGoogleAPIClient;
    FLabels: TLabelsProxy;
    FMessages: TMessagesProxy;
    FAttachments: TAttachmentsProxy;
    procedure DoUserConsent(const aURL: String; out aAuthCode: String);
    procedure EnsureService;
    function ResolveLabelID(const aLabel: String): String;
    function GetMessage(const aID, aFormat: String): TMessage;
    procedure ListLabels;
    procedure ListMessages(const aLabel, aQuery: String; aCount: Integer);
    procedure DisplayMessage(const aID: String);
    procedure DownloadAttachment(const aID: String; aIndex: Integer; const aLocalName: String);
  protected
    procedure DoRun; override;
  public
    constructor Create(aOwner: TComponent); override;
    // Show usage information, with aMsg as error message if not empty, and stop.
    procedure WriteHelp(const aMsg: String); virtual;
  end;

// Raise an exception if a service call did not succeed.
procedure CheckServiceResult(aSuccess: Boolean; aCode: Integer; const aText, aAction: String);

begin
  if not aSuccess then
    raise EGmailDemo.CreateFmt('Failed to %s: HTTP %d %s',[aAction,aCode,aText]);
end;


// Return aText cut to aWidth characters, with ... when it was longer.
function Shorten(const aText: String; aWidth: Integer): String;

begin
  if Length(aText)<=aWidth then
    Result:=aText
  else
    Result:=Copy(aText,1,aWidth-3)+'...';
end;


// Return a file name without directory parts or characters invalid on common file systems.
function SafeFileName(const aName: String): String;

const
  Invalid = ['/','\',':','*','?','"','<','>','|'];

var
  lI: Integer;

begin
  Result:=aName;
  for lI:=1 to Length(Result) do
    if Result[lI] in Invalid then
      Result[lI]:='_';
  if (Result='') or (Result='.') or (Result='..') then
    Result:='attachment';
end;


{ TGmailDemoApplication }

constructor TGmailDemoApplication.Create(aOwner: TComponent);

begin
  inherited Create(aOwner);
  StopOnException:=True;
end;


procedure TGmailDemoApplication.DoUserConsent(const aURL: String; out aAuthCode: String);

var
  lURL, lInput: String;
  lListener: TOAuthRedirectListener;

begin
  // Request a refresh token so the next runs need no consent
  lURL:=aURL+'&access_type=offline&prompt=consent';
  Writeln;
  Writeln('User consent required. Open the following URL in a browser:');
  Writeln;
  Writeln(lURL);
  Writeln;
  if FManual then
    begin
    Writeln('After granting access, the browser is sent to ',FClient.RedirectUri);
    Writeln('and shows a connection error. Copy the full address from the');
    Writeln('browser address bar (or only the code parameter) and paste it here.');
    Writeln;
    Write('URL or code: ');
    ReadLn(lInput);
    aAuthCode:=ExtractAuthCode(lInput);
    end
  else
    begin
    lListener:=TOAuthRedirectListener.Create(FPort);
    try
      Writeln('Waiting for the browser to return to ',lListener.RedirectURI,' ...');
      aAuthCode:=lListener.WaitForCode;
    finally
      lListener.Free;
    end;
    end;
  if aAuthCode='' then
    raise EGmailDemo.Create('No authorization code received');
  Writeln('Authorization code received, requesting tokens.');
  Writeln;
end;


procedure TGmailDemoApplication.EnsureService;

var
  lStore: TFPOAuth2IniStore;

begin
  FClient:=TGoogleAPIClient.Create(Self);
  FClient.WebClient:=TFPHTTPWebClient.Create(Self);
  if FLogFile<>'' then
    FClient.WebClient.LogFile:=FLogFile;
  lStore:=TFPOAuth2IniStore.Create(Self);
  lStore.ConfigFileName:=FConfig;
  lStore.SessionFileName:=FConfig;
  FClient.AuthHandler.Store:=lStore;
  FClient.AuthHandler.LoadConfig;
  if FCredentials<>'' then
    begin
    FClient.RedirectUri:='';
    FClient.LoadCredentials(FCredentials);
    end;
  if not FClient.HasCredentials then
    raise EGmailDemo.CreateFmt('No OAuth2 client ID/secret found in %s. Use -j to import the client JSON file.',[FConfig]);
  FClient.Scopes:=GmailScope;
  FClient.RedirectUri:=Format('http://127.0.0.1:%d',[FPort]);
  FClient.AuthHandler.Config.AccessType:=atOffline;
  if FCredentials<>'' then
    FClient.AuthHandler.SaveConfig;
  FClient.AuthHandler.LoadSession(FSession);
  FClient.OnUserConsent:=@DoUserConsent;
  FLabels:=TLabelsProxy.Create(Self);
  FLabels.BaseURL:=GmailBaseURL;
  FClient.ConfigureService(FLabels);
  FMessages:=TMessagesProxy.Create(Self);
  FMessages.BaseURL:=GmailBaseURL;
  FClient.ConfigureService(FMessages);
  FAttachments:=TAttachmentsProxy.Create(Self);
  FAttachments.BaseURL:=GmailBaseURL;
  FClient.ConfigureService(FAttachments);
end;


procedure TGmailDemoApplication.ListLabels;

var
  lResult: TListLabelsResponseServiceResult;
  lLabel: TLabel;
  lCount: Integer;

begin
  lResult:=FLabels.List;
  CheckServiceResult(lResult.Success,lResult.ErrorCode,lResult.ErrorText,'list labels');
  try
    Writeln(Format('%-7s  %-30s  %s',['Type','ID','Name']));
    lCount:=0;
    for lLabel in lResult.Value.labels do
      begin
      Inc(lCount);
      Writeln(Format('%-7s  %-30s  %s',[lLabel.type_,lLabel.id,lLabel.name]));
      end;
    Writeln;
    Writeln(lCount,' label(s)');
  finally
    lResult.Value.Free;
  end;
end;


function TGmailDemoApplication.ResolveLabelID(const aLabel: String): String;

var
  lResult: TListLabelsResponseServiceResult;
  lLabel: TLabel;

begin
  Result:='';
  lResult:=FLabels.List;
  CheckServiceResult(lResult.Success,lResult.ErrorCode,lResult.ErrorText,'list labels');
  try
    for lLabel in lResult.Value.labels do
      if (Result='') and (SameText(lLabel.id,aLabel) or SameText(lLabel.name,aLabel)) then
        Result:=lLabel.id;
  finally
    lResult.Value.Free;
  end;
  if Result='' then
    raise EGmailDemo.CreateFmt('Label "%s" not found',[aLabel]);
end;


function TGmailDemoApplication.GetMessage(const aID, aFormat: String): TMessage;

var
  lResult: TMessageServiceResult;

begin
  lResult:=FMessages.Get(aID,'',aFormat);
  CheckServiceResult(lResult.Success,lResult.ErrorCode,lResult.ErrorText,'get message '+aID);
  Result:=lResult.Value;
end;


procedure TGmailDemoApplication.ListMessages(const aLabel, aQuery: String; aCount: Integer);

var
  lLabelID, lPageToken: String;
  lResult: TListMessagesResponseServiceResult;
  lRef: TMessage;
  lMessage: TMessage;
  lCount, lPageSize: Integer;

begin
  lLabelID:='';
  if aLabel<>'' then
    lLabelID:=ResolveLabelID(aLabel);
  Writeln(Format('%-16s  %-16s  %-30s  %s',['ID','Date','From','Subject']));
  lCount:=0;
  lPageToken:='';
  repeat
    lPageSize:=aCount-lCount;
    if lPageSize>500 then
      lPageSize:=500;
    lResult:=FMessages.List(lLabelID,lPageToken,aQuery,False,lPageSize);
    CheckServiceResult(lResult.Success,lResult.ErrorCode,lResult.ErrorText,'list messages');
    try
      for lRef in lResult.Value.messages do
        if lCount<aCount then
          begin
          Inc(lCount);
          lMessage:=GetMessage(lRef.id,'metadata');
          try
            Writeln(Format('%-16s  %-16s  %-30s  %s',
              [lMessage.id,
               FormatDateTime('yyyy-mm-dd hh:nn',InternalDateToLocal(lMessage.internalDate)),
               Shorten(DecodeHeaderWords(HeaderValue(lMessage.payload,'From')),30),
               DecodeHeaderWords(HeaderValue(lMessage.payload,'Subject'))]));
          finally
            lMessage.Free;
          end;
          end;
      lPageToken:=lResult.Value.nextPageToken;
    finally
      lResult.Value.Free;
    end;
  until (lPageToken='') or (lCount>=aCount);
  Writeln;
  Writeln(lCount,' message(s)');
end;


procedure TGmailDemoApplication.DisplayMessage(const aID: String);

const
  ShownHeaders: array[0..4] of String = ('From','To','Cc','Date','Subject');

var
  lMessage: TMessage;
  lAttachments: TMessagePartList;
  lHeader, lValue: String;
  lI: Integer;

begin
  lMessage:=GetMessage(aID,'full');
  try
    for lHeader in ShownHeaders do
      begin
      lValue:=HeaderValue(lMessage.payload,lHeader);
      if lValue<>'' then
        Writeln(lHeader,': ',DecodeHeaderWords(lValue));
      end;
    Writeln;
    Writeln(MessageText(lMessage));
    Writeln;
    lAttachments:=[];
    CollectAttachments(lMessage.payload,lAttachments);
    Writeln('Attachments: ',Length(lAttachments));
    for lI:=0 to Length(lAttachments)-1 do
      with lAttachments[lI] do
        Writeln(Format('  %d: %s (%s, %d bytes)',[lI+1,DecodeHeaderWords(filename),mimeType,body.size]));
  finally
    lMessage.Free;
  end;
end;


procedure TGmailDemoApplication.DownloadAttachment(const aID: String; aIndex: Integer; const aLocalName: String);

var
  lMessage: TMessage;
  lAttachments: TMessagePartList;
  lPart: TMessagePart;
  lResult: TMessagePartBodyServiceResult;
  lData: RawByteString;
  lLocalName: String;
  lStream: TFileStream;

begin
  lMessage:=GetMessage(aID,'full');
  try
    lAttachments:=[];
    CollectAttachments(lMessage.payload,lAttachments);
    if (aIndex<1) or (aIndex>Length(lAttachments)) then
      raise EGmailDemo.CreateFmt('Message %s has %d attachment(s), there is no attachment %d',
                                 [aID,Length(lAttachments),aIndex]);
    lPart:=lAttachments[aIndex-1];
    lLocalName:=aLocalName;
    if lLocalName='' then
      lLocalName:=SafeFileName(DecodeHeaderWords(lPart.filename));
    if lPart.body.attachmentId<>'' then
      begin
      lResult:=FAttachments.Get(lPart.body.attachmentId,aID);
      CheckServiceResult(lResult.Success,lResult.ErrorCode,lResult.ErrorText,'get attachment');
      try
        lData:=DecodeBase64URL(lResult.Value.data);
      finally
        lResult.Value.Free;
      end;
      end
    else
      lData:=DecodeBase64URL(lPart.body.data);
  finally
    lMessage.Free;
  end;
  lStream:=TFileStream.Create(lLocalName,fmCreate);
  try
    if Length(lData)>0 then
      lStream.WriteBuffer(lData[1],Length(lData));
  finally
    lStream.Free;
  end;
  Writeln('Saved attachment ',aIndex,' to ',lLocalName,' (',Length(lData),' bytes)');
end;


procedure TGmailDemoApplication.DoRun;

var
  lError: String;

begin
  lError:=CheckOptions('hlb:q:n:r:d:t:c:j:s:o:p:m',
    ['help','labels','label:','query:','count:','read:','download:','to:',
     'config:','credentials:','session:','logfile:','port:','manual']);
  if (lError<>'') or HasOption('h','help') then
    WriteHelp(lError);
  if HasOption('d','download') and not HasOption('r','read') then
    WriteHelp('--download needs --read=ID');
  FConfig:=GetOptionValue('c','config');
  if FConfig='' then
    FConfig:=ExtractFilePath(ParamStr(0))+'google.ini';
  FCredentials:=GetOptionValue('j','credentials');
  FSession:=GetOptionValue('s','session');
  if FSession='' then
    FSession:='me';
  FLogFile:=GetOptionValue('o','logfile');
  FPort:=StrToIntDef(GetOptionValue('p','port'),DefaultPort);
  FManual:=HasOption('m','manual');
  EnsureService;
  try
    if HasOption('d','download') then
      DownloadAttachment(GetOptionValue('r','read'),StrToIntDef(GetOptionValue('d','download'),0),GetOptionValue('t','to'))
    else if HasOption('r','read') then
      DisplayMessage(GetOptionValue('r','read'))
    else if HasOption('b','label') or HasOption('q','query') then
      ListMessages(GetOptionValue('b','label'),GetOptionValue('q','query'),
                   StrToIntDef(GetOptionValue('n','count'),DefaultMessageCount))
    else
      ListLabels;
  finally
    FClient.AuthHandler.SaveSession(FSession);
  end;
  Terminate;
end;


procedure TGmailDemoApplication.WriteHelp(const aMsg: String);

begin
  if aMsg<>'' then
    Writeln('Error : ',aMsg);
  Writeln('Usage: ',ExeName,' [options]');
  Writeln;
  Writeln('Actions (default: --labels):');
  Writeln('  -l --labels               List labels (system folders and user labels).');
  Writeln('  -b --label=LABEL          List messages with label LABEL (name or ID, e.g. INBOX).');
  Writeln('  -q --query=QUERY          List messages matching a Gmail search query (e.g. "has:attachment").');
  Writeln('                            Can be combined with --label.');
  Writeln('  -r --read=ID              Show message ID: headers, text and attachments.');
  Writeln('  -d --download=N           With --read: save attachment N (1-based).');
  Writeln;
  Writeln('Options:');
  Writeln('  -n --count=N              Maximum number of messages to list (default ',DefaultMessageCount,').');
  Writeln('  -t --to=FILE              Local file name for --download (default: attachment name).');
  Writeln('  -c --config=FILE          Config file with client data and tokens (default google.ini).');
  Writeln('  -j --credentials=FILE     Import OAuth client JSON from Google Cloud Console into the config file.');
  Writeln('  -s --session=NAME         Session (token set) name in the config file (default: me).');
  Writeln('  -p --port=PORT            Local port for the OAuth2 redirect (default ',DefaultPort,').');
  Writeln('  -m --manual               Paste the redirect URL instead of running a local listener.');
  Writeln('  -o --logfile=FILE         Log HTTP requests and responses to FILE.');
  Writeln('  -h --help                 This help.');
  Halt(Ord(aMsg<>''));
end;


var
  Application: TGmailDemoApplication;

begin
  Application:=TGmailDemoApplication.Create(nil);
  Application.Title:='Gmail demo';
  Application.Run;
  Application.Free;
end.
