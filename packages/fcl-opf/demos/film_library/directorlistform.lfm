      item
        Title.Caption = 'ID'
        Width = 50
      end
      item
        Title.Caption = 'Name'
        Width = 250
      end
      item
        Title.Caption = 'Country'
        Width = 150
      end>
  end
  object ButtonPanel: TPanel
