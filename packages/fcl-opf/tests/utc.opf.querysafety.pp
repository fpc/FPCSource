procedure TTestDialectDetection.TestFirebirdVersions;
begin
  AssertTrue('3.0.10', DialectFromFirebirdVersion('3.0.10')=dFirebird3);
  AssertTrue('4.0', DialectFromFirebirdVersion('4.0')=dFirebird3);
  AssertTrue('5.0.1', DialectFromFirebirdVersion('5.0.1')=dFirebird3);
  AssertTrue('10.0', DialectFromFirebirdVersion('10.0')=dFirebird3);
  AssertTrue('2.5.9', DialectFromFirebirdVersion('2.5.9')=dFirebird);
  AssertTrue('Prefixed', DialectFromFirebirdVersion('WI-V3.0.4')=dFirebird3);
  AssertTrue('Empty', DialectFromFirebirdVersion('')=dFirebird);
  AssertTrue('Garbage', DialectFromFirebirdVersion('abc')=dFirebird);
  // Server version strings
  AssertTrue('FB4 string', DialectFromFirebirdVersion('LI-V4.0.6.3221 Firebird 4.0')=dFirebird3);
  AssertTrue('FB2.5 string', DialectFromFirebirdVersion('LI-V2.5.9.27139 Firebird 2.5')=dFirebird);
  AssertTrue('InterBase string', DialectFromFirebirdVersion('WI-V7.5.1.80 InterBase')=dFirebird);
  // Zero-padded citServerVersion form: two digits per number
  AssertTrue('040006', DialectFromFirebirdVersion('040006')=dFirebird3);
  AssertTrue('030010', DialectFromFirebirdVersion('030010')=dFirebird3);
  AssertTrue('020501 is 2.5', DialectFromFirebirdVersion('020501')=dFirebird);
end;

procedure TTestDialectDetection.TestConnectorTypes;
begin
  AssertTrue('PostgreSQL', DetectDialectFromConnectorType('PostgreSQL')=dPostGres);
  AssertTrue('Firebird', DetectDialectFromConnectorType('Firebird')=dFirebird);
  AssertTrue('SQLite3', DetectDialectFromConnectorType('SQLite3')=dSQLite);
  AssertTrue('MySQL', DetectDialectFromConnectorType('MySQL 8.0')=dMySQL);
  AssertTrue('MSSQL', DetectDialectFromConnectorType('MSSQLServer')=dSQLServer);
  AssertTrue('Oracle', DetectDialectFromConnectorType('Oracle')=dOracle);
  AssertTrue('ODBC', DetectDialectFromConnectorType('ODBC')=dVanilla);
  AssertTrue('Empty', DetectDialectFromConnectorType('')=dVanilla);
end;

