    procedure TestAppendChar;
    procedure TestQuoteOnDemand;
    procedure TestAlwaysQuote;
    procedure TestMySQLBacktick;
    procedure TestMySQLEmbeddedBacktick;
    procedure TestSQLServerBrackets;
