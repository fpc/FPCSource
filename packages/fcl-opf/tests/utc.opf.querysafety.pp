{ Insert into a missing table with a same-batch driver; returns the error message }

function TTestExecutorBuilder.FailSameBatchInsert(const aResetSQL: UTF8String): String;
var
  O: TQSAutoInc;
  P: TRTTIPersister;
  D: TQSSameBatchDriver;
  B: TOPSQLBuilder;
begin
  Result:='';
  O:=TQSAutoInc.Create;
  P:=TRTTIPersister.Create;
  D:=TQSSameBatchDriver.Create(dSQLite);
  B:=TOPSQLBuilder.Create(Nil);
  try
    D.ResetSQL:=aResetSQL;
    B.Driver:=D;
    B.Registry:=FRegistry;
    O.Name:='x';
    FTrans.StartTransaction;
    try
      OPExecutor.ExecuteSQLAutoInc(O, P, FDef.FieldMap,
        'INSERT INTO QSNoSuchTable (Name) VALUES (:Name)', FConn, B);
    except
      on E: EOPFExecutor do
        Result:=E.Message;
    end;
  finally
    B.Free;
    D.Free;
    P.Free;
    O.Free;
  end;
end;

procedure TTestExecutorBuilder.TestFailedSameBatchInsertResetsSession;
var
  Q: TSQLQuery;
begin
  AssertTrue('Insert failed', FailSameBatchInsert('CREATE TABLE QSResetLog (X INTEGER)')<>'');
  Q:=TSQLQuery.Create(Nil);
  try
    Q.Database:=FConn;
    Q.Transaction:=FTrans;
    Q.SQL.Text:='SELECT COUNT(*) FROM sqlite_master WHERE name=''QSResetLog''';
    Q.Open;
    AssertEquals('Reset statement ran', 1, Q.Fields[0].AsInteger);
    Q.Close;
  finally
    Q.Free;
  end;
  FTrans.Rollback;
end;

procedure TTestExecutorBuilder.TestFailedSessionResetKeepsOriginalError;
var
  Msg: String;
begin
  Msg:=FailSameBatchInsert('THIS IS NOT SQL');
  FTrans.Rollback;
  AssertTrue('Original error reported: '+Msg, Pos('QSNoSuchTable', Msg)>0);
end;

procedure TTestExecutorBuilder.FailingGenerator(aInstance: TObject; aField: TOPFieldMap; aConnection: TObject);
begin
  raise ESQLDatabaseError.CreateFmt('generator failed', [], Nil, 4711, 'HY001');
end;

procedure TTestExecutorBuilder.TestGeneratorErrorKeepsDetails;
var
  O: TQSAutoInc;
  P: TRTTIPersister;
  F: TOPFieldMap;
  Code: Integer;
  State: String;
begin
  F:=FDef.FieldMap.FindByPropertyName('Name');
  F.OnGenerateValue:=@FailingGenerator;
  O:=TQSAutoInc.Create;
  P:=TRTTIPersister.Create;
  try
    Code:=0;
    State:='';
    FTrans.StartTransaction;
    try
      OPExecutor.ExecuteSQLWithGeneration(O, P, FDef.FieldMap,
        FBuilder.GetInsertSQL(FDef.TableName, FDef.FieldMap.AsArray), FConn, FBuilder);
    except
      on E: EOPF do
      begin
        Code:=E.ErrorCode;
        State:=E.SQLState;
      end;
    end;
    FTrans.Rollback;
    AssertEquals('Error code passed on', 4711, Code);
    AssertEquals('SQL state passed on', 'HY001', State);
  finally
    F.OnGenerateValue:=Nil;
    P.Free;
    O.Free;
  end;
end;

