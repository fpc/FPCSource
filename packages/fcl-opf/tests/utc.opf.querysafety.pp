function TTestManagerQuerySQL.WherePart(const aSQL: UTF8String): UTF8String;
var
  P: Integer;
begin
  P:=Pos(' WHERE ', aSQL);
  if P=0 then
    Result:=''
  else
    Result:=Copy(aSQL, P+7, Length(aSQL));
end;

