unit utc.opf.querysafety;

{ Tests for query construction safety:
  - parenthesization of AND/OR in criteria and around the soft-delete filter
  - field name validation, ORDER BY parsing, raw criteria
  - identifier formatting (quoting / reserved words) in driver and builders
  - LINQ operators that do not consume their operands
  - SQL generated by the manager for criteria, children and associations }

{$mode objfpc}{$H+}
{$modeswitch advancedrecords}
{$INTERFACES COM}

interface

uses
{$IFDEF FPC_DOTTEDUNITS}
  System.Classes, System.SysUtils, System.Contnrs, Data.Db, FpcUnit.Test, FpcUnit.TestRegistry,
{$ELSE}
  Classes, SysUtils, Contnrs, DB, fpcunit, testregistry,
{$ENDIF}
{$IFDEF FPC_DOTTEDUNITS}
  Data.Sqldb, Data.SqlDb.Sqlite3,
{$ELSE}
  sqldb, sqlite3conn,
{$ENDIF}
  Opf.Types, Opf.Fields, Opf.Criteria, Opf.Linq, Opf.Driver, Opf.Sql, Opf.DDL,
  Opf.Registry, Opf.Manager, Opf.Persister.RTTI, Opf.Executor;

