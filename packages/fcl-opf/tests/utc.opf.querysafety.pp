procedure TTestManagerQuerySQL.TestParentKeyParamsTyped;
var
  C: TQSContact;
  P: TParams;
begin
  C:=TQSContact.Create;
  try
    C.ID:=42;
    P:=FManager.ParentKeyParams(C, FDef);
    try
      AssertEquals('One param', 1, P.Count);
