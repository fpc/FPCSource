procedure TTestExecutorBuilder.SetUp;
var
  Q: TSQLQuery;
  C: TOPConnection;
  F: TOPFieldMap;
begin
  inherited SetUp;
  // The global builder deliberately uses another dialect than the manager
  FSavedDialect:=OPSQLBuilder.SQLDialect;
  OPSQLBuilder.SQLDialect:=dPostGres;
  FConn:=TSQLite3Connection.Create(Nil);
  FConn.DatabaseName:=':memory:';
  FTrans:=TSQLTransaction.Create(Nil);
  FTrans.Database:=FConn;
  FConn.Transaction:=FTrans;
  FConn.Open;
  Q:=TSQLQuery.Create(Nil);
  try
    Q.Database:=FConn;
    Q.Transaction:=FTrans;
    FTrans.StartTransaction;
    Q.SQL.Text:='CREATE TABLE QSAutoInc (ID INTEGER PRIMARY KEY AUTOINCREMENT, Name TEXT)';
    Q.ExecSQL;
    FTrans.Commit;
  finally
    Q.Free;
  end;
  FRegistry:=TOPRegistry.Create(Nil);
  FBuilder:=TQSRecordingBuilder.Create(Nil);
  FBuilder.SQLDialect:=dSQLite;
  FBuilder.Registry:=FRegistry;
  FManager:=TOPManager.Create(Nil);
  FManager.Registry:=FRegistry;
  FManager.SQLBuilder:=FBuilder;
  C:=FManager.Connections.Add as TOPConnection;
  C.SingleConnection:=FConn;
  C.IsDefault:=True;
  FDef:=FRegistry.RegisterPersister(TQSAutoInc, TRTTIPersister);
  F:=FDef.FieldMap.FindByPropertyName('ID');
  F.Options:=F.Options + [foAutoInc, foInKey] - [foInInsert];
end;

procedure TTestExecutorBuilder.TearDown;
begin
  FreeAndNil(FManager);
  FreeAndNil(FBuilder);
  FreeAndNil(FRegistry);
  if Assigned(FConn) then
  begin
    if FTrans.Active then
      FTrans.Rollback;
    FConn.Close;
  end;
  FreeAndNil(FTrans);
  FreeAndNil(FConn);
  OPSQLBuilder.SQLDialect:=FSavedDialect;
  inherited TearDown;
end;

procedure TTestExecutorBuilder.TestAutoIncUsesManagerBuilder;
var
  O: TQSAutoInc;
begin
  O:=TQSAutoInc.Create;
  try
    O.Name:='Alice';
    // With the global (PostgreSQL) builder, the executor would expect a
    // RETURNING clause that the SQLite builder did not generate.
    FManager.Save(O, opsNew);
    AssertEquals('ID retrieved', 1, O.ID);
    AssertEquals('Manager builder consulted', 1, FBuilder.PostInsertCalls);
  finally
    O.Free;
  end;
end;

procedure TTestExecutorBuilder.TestAutoIncSequentialIDs;
var
  O1, O2: TQSAutoInc;
begin
  O1:=TQSAutoInc.Create;
  O2:=TQSAutoInc.Create;
  try
    FManager.Save(O1, opsNew);
    FManager.Save(O2, opsNew);
    AssertEquals('First', 1, O1.ID);
    AssertEquals('Second', 2, O2.ID);
  finally
    O2.Free;
    O1.Free;
  end;
end;

procedure TTestExecutorBuilder.TestSequenceUsesManagerBuilder;
var
  O: TQSAutoInc;
  F: TOPFieldMap;
begin
  F:=FDef.FieldMap.FindByPropertyName('ID');
  F.Options:=F.Options - [foAutoInc] + [foInInsert];
  F.SequenceName:='qs_seq';
  O:=TQSAutoInc.Create;
  try
    FManager.Save(O, opsNew);
    AssertEquals('Sequence value from the manager builder', 42, O.ID);
    AssertEquals('Manager builder consulted', 1, FBuilder.SequenceCalls);
  finally
    O.Free;
  end;
end;

procedure TTestExecutorBuilder.TestNilBuilderFallsBackToGlobal;
var
  O: TQSAutoInc;
  P: TRTTIPersister;
begin
  OPSQLBuilder.SQLDialect:=dSQLite;
  O:=TQSAutoInc.Create;
  P:=TRTTIPersister.Create;
  try
    O.Name:='Bob';
    FTrans.StartTransaction;
    OPExecutor.ExecuteSQLAutoInc(O, P, FDef.FieldMap,
      FBuilder.GetInsertSQL(FDef.TableName, FDef.FieldMap.AsArray), FConn, Nil);
    FTrans.Commit;
    AssertEquals('ID retrieved through the global builder', 1, O.ID);
    AssertEquals('Manager builder not consulted', 0, FBuilder.PostInsertCalls);
  finally
    P.Free;
    O.Free;
  end;
end;

function TQSParamBuilder.GetParamName(const F: TOPFieldMap): String;
begin
  Result:='x_'+inherited GetParamName(F);
