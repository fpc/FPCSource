procedure TTestExecutorBuilder.ExecSQL(const aSQL: String);
var
  Q: TSQLQuery;
begin
  Q:=TSQLQuery.Create(Nil);
  try
    Q.Database:=FConn;
    Q.Transaction:=FTrans;
    if not FTrans.Active then
      FTrans.StartTransaction;
    Q.SQL.Text:=aSQL;
    Q.ExecSQL;
    FTrans.Commit;
  finally
    Q.Free;
  end;
end;

procedure TTestExecutorBuilder.TestAppendCharSaveAndLoad;
var
  O: TQSAutoInc;
  L: TObjectList;
  C: TOPCriteria;
begin
  // Property Name is stored in column "Order", a reserved word: Order_ in the database
  ExecSQL('ALTER TABLE QSAutoInc ADD COLUMN Order_ TEXT');
  FDef.FieldMap.FindByPropertyName('Name').FieldName:='Order';
  FBuilder.Driver.ReservedWordStrategy:=rwsAppendChar;
  AssertEquals('Physical name', 'Order_', FBuilder.PhysicalName('Order'));
  AssertEquals('Regular name unchanged', 'Name', FBuilder.PhysicalName('Name'));
  O:=TQSAutoInc.Create;
  L:=TObjectList.Create(True);
  C:=TOPCriteria.Create;
  try
    O.Name:='Alice';
    FManager.Save(O, opsNew);
    AssertEquals('ID', 1, O.ID);
    // Raised "Result set missing column" before the fix
    FManager.Load(L, TQSAutoInc, C.Where('Name', opEqual, 'Alice'));
    AssertEquals('Loaded by criteria', 1, L.Count);
    AssertEquals('List value', 'Alice', TQSAutoInc(L[0]).Name);
    L.Clear;
    // Hand-written SQL may use the physical name
    FManager.LoadSQL(L, TQSAutoInc, 'SELECT ID, Order_ FROM QSAutoInc');
    AssertEquals('LoadSQL', 'Alice', TQSAutoInc(L[0]).Name);
  finally
    C.Free;
    L.Free;
    O.Free;
  end;
end;

procedure TTestExecutorBuilder.TestBuilderParamNamesOnUpdate;
var
  B: TQSParamBuilder;
  O: TQSAutoInc;
  L: TObjectList;
  C: TOPCriteria;
begin
  B:=TQSParamBuilder.Create(Nil);
  O:=TQSAutoInc.Create;
  L:=TObjectList.Create(True);
  C:=TOPCriteria.Create;
  try
    B.SQLDialect:=dSQLite;
    B.Registry:=FRegistry;
    FManager.SQLBuilder:=B;
    O.Name:='Alice';
    FManager.Save(O, opsNew);
    O.Name:='Bob';
    // Plain UPDATE: the executor looked for :Name, the SQL has :x_Name
    FManager.Save(O, opsUpdate);
    FManager.Load(L, TQSAutoInc, C.Where('ID', opEqual, O.ID));
    AssertEquals('One row', 1, L.Count);
    AssertEquals('Updated through the builder parameter names', 'Bob', TQSAutoInc(L[0]).Name);
  finally
    FManager.SQLBuilder:=FBuilder;
    C.Free;
    L.Free;
    O.Free;
    B.Free;
  end;
end;

procedure TTestExecutorBuilder.TestUnboundParamRaisesWithBuilder;
var
  O: TQSAutoInc;
  P: TRTTIPersister;
  Raised: Boolean;
begin
  O:=TQSAutoInc.Create;
  P:=TRTTIPersister.Create;
  try
    O.ID:=1;
    Raised:=False;
    FTrans.StartTransaction;
    try
      OPExecutor.ExecuteSQL(O, P, FDef.FieldMap,
        'UPDATE QSAutoInc SET Name=:Bogus WHERE ID=:ID', FConn, FBuilder);
    except
      on E: EOPFExecutor do
        Raised:=Pos('Bogus', E.Message)>0;
    end;
    FTrans.Rollback;
    AssertTrue('Parameter that no field fills raises', Raised);
  finally
    P.Free;
    O.Free;
  end;
end;

