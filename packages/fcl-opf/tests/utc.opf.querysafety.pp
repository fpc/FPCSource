    procedure AssertRaises(const aMsg: String; const aField: UTF8String);
  protected
    procedure SetUp; override;
    procedure TearDown; override;
  published
    // Parenthesization
    procedure TestOrThenAndIsBracketed;
    procedure TestAndThenOrIsBracketed;
    procedure TestSameOperatorChainUnbracketed;
    procedure TestOrChainUnbracketed;
    procedure TestNotOrThenAnd;
    procedure TestThreeLevelMixed;
    procedure TestSubCriteriaGroupKept;
    // Field names
    procedure TestUnknownFieldRaises;
    procedure TestUnknownFieldInOrderByRaises;
    procedure TestMappedColumnNameAccepted;
    procedure TestPropertyNameCaseInsensitive;
    procedure TestInvalidNamesWithoutMapRaise;
    procedure TestQualifiedNameWithoutMapAccepted;
    // ORDER BY
    procedure TestOrderByDescInString;
    procedure TestOrderByAscInString;
    procedure TestOrderByListInString;
    procedure TestOrderByInjectionRaises;
    procedure TestOrderBySuffixRaises;
    procedure TestOrderByResolvesFields;
    // Formatter
    procedure TestFormatterAppliedEverywhere;
    procedure TestFormatterOrderBy;
    procedure TestFormatterNotAppliedToRaw;
    procedure TestFormatterResetAfterCall;
    // Raw
    procedure TestWhereRaw;
    procedure TestWhereRawQuotedQuestionMark;
    procedure TestWhereRawCountMismatchRaises;
    procedure TestAddAndRaw;
    procedure TestAddOrRawThenAnd;
    procedure TestRawInSubRenumbered;
    // Empty IN
    procedure TestEmptyWhereIn;
    procedure TestEmptyWhereNotIn;
    procedure TestEmptyAddAndIn;
    // Sub criteria
    procedure TestEmptySubIgnored;
    procedure TestEmptyBaseWithSub;
    procedure TestAddSelfRaises;
    procedure TestAddSameSubTwiceRaises;
    procedure TestAddAndCopyLeavesSubUsable;
    procedure TestMergeKeepsParamTypes;
    // Clone
    procedure TestCloneIndependent;
    procedure TestCloneKeepsSettings;
    procedure TestCloneKeepsParamTypes;
    procedure TestCloneOfEmpty;
    // Review-2: sub-criteria ownership, failing Where, dates in array of const
    procedure TestSubOwnedByTwoRaises;
    procedure TestOwnershipCycleRaises;
    procedure TestFailedWhereKeepsConditions;
    procedure TestFailedWhereRawKeepsConditions;
    procedure TestDateInArrayOfConstBoundAsDate;
    procedure TestFloatInArrayOfConstStaysFloat;
  end;

  { TTestLinqReuse }

  TTestLinqReuse = class(TTestCase)
  published
    procedure TestOperandReusableAfterAnd;
    procedure TestOperandReusableAfterOr;
    procedure TestSelfAnd;
    procedure TestSelfOr;
    procedure TestNotKeepsOperand;
    procedure TestOrThenAndBracketed;
    procedure TestReuseInMultipleCombinations;
    procedure TestUnassignedLeftRaises;
