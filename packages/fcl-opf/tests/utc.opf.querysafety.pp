    AssertTrue('Child table quoted: '+S, Pos('ALTER TABLE "OrderLine"', S)>0);
    AssertTrue('FK column quoted: '+S, Pos('("OrderID")', S)>0);
    AssertTrue('Parent quoted: '+S, Pos('REFERENCES "Order"("ID")', S)>0);
