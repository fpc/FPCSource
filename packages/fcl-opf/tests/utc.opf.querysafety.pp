procedure TTestIdentifierFormatting.UseDriver(aDialect: TSQLDialect; aStrategy: TReservedWordStrategy);
begin
  FreeAndNil(FDriver);
  FDriver:=TSQLDriver.CreateDriver(aDialect);
  FDriver.ReservedWordStrategy:=aStrategy;
end;

procedure TTestIdentifierFormatting.AssertUnsafe(const aIdentifier: UTF8String);
var
  Raised: Boolean;
begin
  Raised:=False;
  try
    FDriver.FormatIdentifier(aIdentifier, False);
  except
    on EOPF do
      Raised:=True;
  end;
  AssertTrue('Unsafe identifier raises: '+aIdentifier, Raised);
end;

procedure TTestIdentifierFormatting.TearDown;
begin
  FreeAndNil(FDriver);
  inherited TearDown;
end;

procedure TTestIdentifierFormatting.TestRegularUnchanged;
begin
  UseDriver(dPostGres);
  AssertEquals('Regular', 'FirstName', FDriver.FormatIdentifier('FirstName', False));
  AssertEquals('With digits and $', 'a_1$x', FDriver.FormatIdentifier('a_1$x', False));
end;

procedure TTestIdentifierFormatting.TestIrregularIsQuoted;
