implementation

{ 'Zoë' as UTF-8, built from bytes so no source codepage conversion applies }

function NonAsciiName: UTF8String;
const
  Bytes: array[0..3] of Byte = (Ord('Z'), Ord('o'), $C3, $AB);
var
  I: Integer;
begin
  SetLength(Result, Length(Bytes));
  for I:=0 to High(Bytes) do
    Result[I+1]:=AnsiChar(Bytes[I]);
end;

{ ---------------------------------------------------------------------
  TTestCriteriaSafety
  ---------------------------------------------------------------------}

function TTestCriteriaSafety.AddField(const aProp, aField: UTF8String): TOPFieldMap;
begin
  Result:=FMap.Add as TOPFieldMap;
  Result.PropertyName:=aProp;
  Result.FieldName:=aField;
  Result.PropertyKind:=tkInteger;
end;

function TTestCriteriaSafety.Quote(const aName: UTF8String): UTF8String;
begin
  Result:='"'+aName+'"';
end;

procedure TTestCriteriaSafety.AssertRaises(const aMsg: String; const aField: UTF8String);
var
  C: TOPCriteria;
  Raised: Boolean;
begin
  Raised:=False;
  C:=TOPCriteria.Create;
  try
    C.Where(aField, opEqual, 1);
    try
      C.ToWhereSQL(Nil);
    except
      on E: EOPF do
        Raised:=True;
    end;
  finally
    C.Free;
  end;
  AssertTrue(aMsg+' ('+aField+')', Raised);
end;

procedure TTestCriteriaSafety.SetUp;
begin
  inherited SetUp;
  FCrit:=TOPCriteria.Create;
  FMap:=TOPFieldMapList.Create(TOPFieldMap);
  AddField('A', 'col_a');
  AddField('B', 'col_b');
  AddField('C', 'col_c');
  AddField('Name', 'name');
end;

procedure TTestCriteriaSafety.TearDown;
begin
  FreeAndNil(FMap);
  FreeAndNil(FCrit);
  inherited TearDown;
end;

procedure TTestCriteriaSafety.TestOrThenAndIsBracketed;
begin
  FCrit.Where('A', opEqual, 1).AddOr('B', opEqual, 2).AddAnd('C', opEqual, 3);
  AssertEquals('(A OR B) AND C', '(A = :p1 OR B = :p2) AND C = :p3', FCrit.ToWhereSQL(Nil));
end;

procedure TTestCriteriaSafety.TestAndThenOrIsBracketed;
begin
  FCrit.Where('A', opEqual, 1).AddAnd('B', opEqual, 2).AddOr('C', opEqual, 3);
  AssertEquals('(A AND B) OR C', '(A = :p1 AND B = :p2) OR C = :p3', FCrit.ToWhereSQL(Nil));
end;

procedure TTestCriteriaSafety.TestSameOperatorChainUnbracketed;
begin
  FCrit.Where('A', opEqual, 1).AddAnd('B', opEqual, 2).AddAnd('C', opEqual, 3);
  AssertEquals('AND chain', 'A = :p1 AND B = :p2 AND C = :p3', FCrit.ToWhereSQL(Nil));
end;

procedure TTestCriteriaSafety.TestOrChainUnbracketed;
begin
  FCrit.Where('A', opEqual, 1).AddOr('B', opEqual, 2).AddOr('C', opEqual, 3);
  AssertEquals('OR chain', 'A = :p1 OR B = :p2 OR C = :p3', FCrit.ToWhereSQL(Nil));
end;

procedure TTestCriteriaSafety.TestNotOrThenAnd;
begin
  FCrit.Where('A', opEqual, 1).AddOr('B', opEqual, 2).Not_.AddAnd('C', opEqual, 3);
  AssertEquals('NOT (A OR B) AND C', 'NOT (A = :p1 OR B = :p2) AND C = :p3', FCrit.ToWhereSQL(Nil));
end;

procedure TTestCriteriaSafety.TestThreeLevelMixed;
begin
  FCrit.Where('A', opEqual, 1).AddOr('B', opEqual, 2).AddAnd('C', opEqual, 3).AddOr('Name', opEqual, 'x');
  AssertEquals('((A OR B) AND C) OR Name',
    '((A = :p1 OR B = :p2) AND C = :p3) OR Name = :p4', FCrit.ToWhereSQL(Nil));
end;

procedure TTestCriteriaSafety.TestSubCriteriaGroupKept;
var
  Sub: TOPCriteria;
begin
  Sub:=TOPCriteria.Create;
  Sub.Where('B', opEqual, 2).AddAnd('C', opEqual, 3);
  FCrit.Where('A', opEqual, 1).AddOr(Sub);
  AssertEquals('A OR (B AND C)', 'A = :p1 OR (B = :p2 AND C = :p3)', FCrit.ToWhereSQL(Nil));
end;

procedure TTestCriteriaSafety.TestUnknownFieldRaises;
begin
  FCrit.Where('Unknown', opEqual, 1);
  try
    FCrit.ToWhereSQL(FMap);
    Fail('Unknown property must raise');
  except
    on E: EOPF do
      AssertTrue('Message names the field: '+E.Message, Pos('Unknown', E.Message)>0);
  end;
end;

procedure TTestCriteriaSafety.TestUnknownFieldInOrderByRaises;
begin
  FCrit.OrderBy('Unknown');
  try
    FCrit.ToOrderBySQL(FMap);
    Fail('Unknown ORDER BY field must raise');
  except
    on EOPF do ;
  end;
end;

procedure TTestCriteriaSafety.TestMappedColumnNameAccepted;
begin
  FCrit.Where('col_b', opEqual, 2);
  AssertEquals('Column name accepted', 'col_b = :p1', FCrit.ToWhereSQL(FMap));
end;

procedure TTestCriteriaSafety.TestPropertyNameCaseInsensitive;
begin
  FCrit.Where('name', opEqual, 'x').AddAnd('NAME', opEqual, 'y');
  AssertEquals('Case insensitive lookup', 'name = :p1 AND name = :p2', FCrit.ToWhereSQL(FMap));
end;

procedure TTestCriteriaSafety.TestInvalidNamesWithoutMapRaise;
begin
  AssertRaises('Statement separator', 'x; DROP TABLE t');
  AssertRaises('Expression', '1=1 OR a');
  AssertRaises('Space', 'a b');
  AssertRaises('Parenthesis', 'a)');
  AssertRaises('Comment', 'a--');
  AssertRaises('Quote', 'a''b');
  AssertRaises('Leading digit', '1a');
  AssertRaises('Empty', '');
  AssertRaises('Trailing dot', 'a.');
  AssertRaises('Leading dot', '.a');
end;

procedure TTestCriteriaSafety.TestQualifiedNameWithoutMapAccepted;
begin
  FCrit.Where('t.Name', opEqual, 'x').AddAnd('_x$1', opEqual, 1);
  AssertEquals('Qualified', 't.Name = :p1 AND _x$1 = :p2', FCrit.ToWhereSQL(Nil));
end;

procedure TTestCriteriaSafety.TestOrderByDescInString;
begin
  FCrit.OrderBy('Name DESC');
  AssertEquals('DESC in string', 'ORDER BY Name DESC', FCrit.ToOrderBySQL(Nil));
end;

procedure TTestCriteriaSafety.TestOrderByAscInString;
begin
  FCrit.OrderBy('Name asc', True);
  AssertEquals('ASC in string wins', 'ORDER BY Name', FCrit.ToOrderBySQL(Nil));
end;

procedure TTestCriteriaSafety.TestOrderByListInString;
begin
  FCrit.OrderBy('A, B DESC').OrderBy('C', True);
  AssertEquals('List', 'ORDER BY A, B DESC, C DESC', FCrit.ToOrderBySQL(Nil));
end;

procedure TTestCriteriaSafety.TestOrderByInjectionRaises;
begin
  try
    FCrit.OrderBy('Name (CASE WHEN (SELECT 1)=1 THEN 1 END)');
    Fail('Expression in ORDER BY must raise');
  except
    on EOPF do ;
  end;
end;

procedure TTestCriteriaSafety.TestOrderBySuffixRaises;
begin
  try
    FCrit.OrderBy('Name DESC, (SELECT 1)');
    FCrit.ToOrderBySQL(Nil);
    Fail('Expression item in ORDER BY must raise');
  except
    on EOPF do ;
  end;
end;

procedure TTestCriteriaSafety.TestOrderByResolvesFields;
begin
  FCrit.OrderBy('A').OrderBy('Name', True);
  AssertEquals('Resolved', 'ORDER BY col_a, name DESC', FCrit.ToOrderBySQL(FMap));
end;

procedure TTestCriteriaSafety.TestFormatterAppliedEverywhere;
begin
  FCrit.Where('A', opEqual, 1)
       .AddAndIn('B', [1, 2])
       .AddAndBetween('C', [1, 9])
       .AddAndIsNull('Name');
  AssertEquals('Formatted',
    '"col_a" = :p1 AND "col_b" IN (:p2,:p3) AND "col_c" BETWEEN :p4 AND :p5 AND "name" IS NULL',
    FCrit.ToWhereSQL(FMap, @Quote));
end;

procedure TTestCriteriaSafety.TestFormatterOrderBy;
begin
  FCrit.OrderBy('A DESC');
  AssertEquals('Formatted order', 'ORDER BY "col_a" DESC', FCrit.ToOrderBySQL(FMap, @Quote));
end;

procedure TTestCriteriaSafety.TestFormatterNotAppliedToRaw;
begin
  FCrit.WhereRaw('LOWER(name) = ?', ['x']);
  AssertEquals('Raw untouched', '(LOWER(name) = :p1)', FCrit.ToWhereSQL(FMap, @Quote));
end;

procedure TTestCriteriaSafety.TestFormatterResetAfterCall;
begin
  FCrit.Where('A', opEqual, 1);
  FCrit.ToWhereSQL(FMap, @Quote);
  AssertEquals('Formatter not kept', 'col_a = :p1', FCrit.ToWhereSQL(FMap));
end;

procedure TTestCriteriaSafety.TestWhereRaw;
begin
  FCrit.WhereRaw('LOWER(Name) = ? AND Age > ?', ['bob', 18]);
  AssertEquals('Raw', '(LOWER(Name) = :p1 AND Age > :p2)', FCrit.ToWhereSQL(Nil));
  AssertEquals('Param 1', 'bob', FCrit.Params[0].AsString);
  AssertEquals('Param 2', 18, FCrit.Params[1].AsInteger);
end;

procedure TTestCriteriaSafety.TestWhereRawQuotedQuestionMark;
begin
  FCrit.WhereRaw('Name = ''?'' OR "a?b" = ?', [1]);
  AssertEquals('Quoted ? untouched', '(Name = ''?'' OR "a?b" = :p1)', FCrit.ToWhereSQL(Nil));
end;

procedure TTestCriteriaSafety.TestWhereRawCountMismatchRaises;
begin
  try
    FCrit.WhereRaw('A = ? AND B = ?', [1]);
    Fail('Placeholder count mismatch must raise');
  except
    on EOPF do ;
  end;
end;

procedure TTestCriteriaSafety.TestAddAndRaw;
begin
  FCrit.Where('A', opEqual, 1).AddAndRaw('B > ?', [2]);
  AssertEquals('And raw', 'A = :p1 AND (B > :p2)', FCrit.ToWhereSQL(Nil));
end;

procedure TTestCriteriaSafety.TestAddOrRawThenAnd;
begin
  FCrit.Where('A', opEqual, 1).AddOrRaw('B > ?', [2]).AddAnd('C', opEqual, 3);
  AssertEquals('Or raw then and', '(A = :p1 OR (B > :p2)) AND C = :p3', FCrit.ToWhereSQL(Nil));
end;

procedure TTestCriteriaSafety.TestRawInSubRenumbered;
var
  Sub: TOPCriteria;
begin
  Sub:=TOPCriteria.Create;
  Sub.WhereRaw('X = ?', [5]);
  FCrit.Where('A', opEqual, 1).AddAnd(Sub);
  AssertEquals('Renumbered', 'A = :p1 AND ((X = :p2))', FCrit.ToWhereSQL(Nil));
  AssertEquals('Value copied', 5, FCrit.Params[1].AsInteger);
end;

procedure TTestCriteriaSafety.TestEmptyWhereIn;
begin
  FCrit.WhereIn('A', []);
  AssertEquals('Empty IN matches nothing', '1=0', FCrit.ToWhereSQL(FMap));
end;

procedure TTestCriteriaSafety.TestEmptyWhereNotIn;
begin
  FCrit.WhereNotIn('A', []);
  AssertEquals('Empty NOT IN matches all', '1=1', FCrit.ToWhereSQL(FMap));
end;

procedure TTestCriteriaSafety.TestEmptyAddAndIn;
begin
  FCrit.Where('A', opEqual, 1).AddOrIn('B', []);
  AssertEquals('Empty IN in OR', 'col_a = :p1 OR 1=0', FCrit.ToWhereSQL(FMap));
end;

procedure TTestCriteriaSafety.TestEmptySubIgnored;
begin
  FCrit.Where('A', opEqual, 1).AddAnd(TOPCriteria.Create);
  AssertEquals('Empty sub ignored', 'A = :p1', FCrit.ToWhereSQL(Nil));
end;

procedure TTestCriteriaSafety.TestEmptyBaseWithSub;
var
  Sub: TOPCriteria;
begin
  Sub:=TOPCriteria.Create;
  Sub.Where('A', opEqual, 1);
  FCrit.AddOr(Sub);
  AssertEquals('Sub becomes root', '(A = :p1)', FCrit.ToWhereSQL(Nil));
end;

procedure TTestCriteriaSafety.TestAddSelfRaises;
begin
  FCrit.Where('A', opEqual, 1);
  try
    FCrit.AddAnd(FCrit);
    Fail('Adding a criteria to itself must raise');
  except
    on EOPF do ;
  end;
  AssertEquals('Unchanged', 'A = :p1', FCrit.ToWhereSQL(Nil));
end;

procedure TTestCriteriaSafety.TestAddSameSubTwiceRaises;
var
  Sub: TOPCriteria;
begin
  Sub:=TOPCriteria.Create;
  Sub.Where('B', opEqual, 2);
  FCrit.Where('A', opEqual, 1).AddAnd(Sub);
  try
    FCrit.AddOr(Sub);
    Fail('Adding an owned sub again must raise');
  except
    on EOPF do ;
  end;
  // No double free on destruction: verified by heaptrc
end;

procedure TTestCriteriaSafety.TestAddAndCopyLeavesSubUsable;
var
  Sub: TOPCriteria;
begin
  Sub:=TOPCriteria.Create;
  try
    Sub.Where('B', opEqual, 2);
    FCrit.Where('A', opEqual, 1).AddAndCopy(Sub).AddOrCopy(Sub);
    AssertEquals('Copies', '(A = :p1 AND (B = :p2)) OR (B = :p3)', FCrit.ToWhereSQL(Nil));
    AssertEquals('Sub unchanged', 'B = :p1', Sub.ToWhereSQL(Nil));
  finally
    Sub.Free;
  end;
end;

procedure TTestCriteriaSafety.TestMergeKeepsParamTypes;
var
  Sub: TOPCriteria;
begin
  Sub:=TOPCriteria.Create;
  try
    Sub.Where('A', opEqual, Int64(5000000000)).AddAnd('B', opEqual, EncodeDate(2026,1,2));
    FCrit.AddAndCopy(Sub);
    AssertEquals('Int64 type', Ord(ftLargeint), Ord(FCrit.Params[0].DataType));
    AssertEquals('Int64 value', 5000000000, FCrit.Params[0].AsLargeInt);
    AssertEquals('Date type', Ord(ftDateTime), Ord(FCrit.Params[1].DataType));
    AssertEquals('Date value', EncodeDate(2026,1,2), FCrit.Params[1].AsDateTime);
  finally
    Sub.Free;
  end;
end;

procedure TTestCriteriaSafety.TestCloneIndependent;
var
  D: TOPCriteria;
begin
  FCrit.Where('A', opEqual, 1);
  D:=FCrit.Clone;
  try
    FCrit.AddAnd('B', opEqual, 2);
    D.AddOr('C', opEqual, 3);
    AssertEquals('Original', 'A = :p1 AND B = :p2', FCrit.ToWhereSQL(Nil));
    AssertEquals('Clone', 'A = :p1 OR C = :p2', D.ToWhereSQL(Nil));
    AssertEquals('Clone params', 2, D.Params.Count);
  finally
    D.Free;
  end;
end;

procedure TTestCriteriaSafety.TestCloneKeepsSettings;
var
  D: TOPCriteria;
begin
  FCrit.Where('A', opEqual, 1).OrderBy('B', True).Limit(5).Offset(10).IncludeDeleted;
  D:=FCrit.Clone;
  try
    AssertEquals('Order', 'ORDER BY B DESC', D.ToOrderBySQL(Nil));
    AssertEquals('Limit', 5, D.GetLimitValue);
    AssertEquals('Offset', 10, D.GetOffsetValue);
    AssertTrue('IncludeDeleted', D.HasIncludeDeleted);
  finally
    D.Free;
  end;
end;

procedure TTestCriteriaSafety.TestCloneKeepsParamTypes;
var
  D: TOPCriteria;
begin
  FCrit.Where('A', opEqual, Int64(1) shl 40)
       .AddAnd('B', opEqual, Double(1.5))
       .AddAnd('C', opEqual, True)
       .AddAnd('Name', opEqual, NonAsciiName);
  D:=FCrit.Clone;
  try
    AssertEquals('Int64', Ord(ftLargeint), Ord(D.Params[0].DataType));
    AssertEquals('Int64 value', Int64(1) shl 40, D.Params[0].AsLargeInt);
    AssertEquals('Float', Ord(ftFloat), Ord(D.Params[1].DataType));
    AssertEquals('Float value', 1.5, D.Params[1].AsFloat, 0);
    AssertEquals('Boolean', Ord(ftBoolean), Ord(D.Params[2].DataType));
    AssertTrue('String value', UTF8String(D.Params[3].AsString)=NonAsciiName);
    AssertEquals('Same param names', FCrit.Params[3].Name, D.Params[3].Name);
  finally
    D.Free;
  end;
end;

procedure TTestCriteriaSafety.TestCloneOfEmpty;
var
  D: TOPCriteria;
begin
  D:=FCrit.Clone;
  try
    AssertFalse('No where', D.HasWhereClause);
    AssertEquals('Empty SQL', '', D.ToWhereSQL(Nil));
  finally
    D.Free;
  end;
end;

procedure TTestCriteriaSafety.TestSubOwnedByTwoRaises;
var
  B, Sub: TOPCriteria;
begin
  Sub:=TOPCriteria.Create;
  Sub.Where('C', opEqual, 3);
  B:=TOPCriteria.Create;
  try
    FCrit.Where('A', opEqual, 1).AddAnd(Sub);
    try
      B.AddAnd(Sub);
      Fail('A sub owned by another criteria must not be taken again');
    except
      on E: EOPF do ;
    end;
    AssertEquals('Not merged', '', B.ToWhereSQL(Nil));
  finally
    // No double free of Sub: verified by heaptrc
    B.Free;
  end;
end;

procedure TTestCriteriaSafety.TestOwnershipCycleRaises;
var
  B: TOPCriteria;
begin
  B:=TOPCriteria.Create;
  B.Where('B', opEqual, 2);
  FCrit.Where('A', opEqual, 1).AddAnd(B);
  try
    B.AddAnd(FCrit);
    Fail('Adding the owner to its own sub-criteria must raise');
  except
    on E: EOPF do ;
  end;
  // FCrit frees B; B must not free FCrit (endless recursion before the fix)
end;

procedure TTestCriteriaSafety.TestFailedWhereKeepsConditions;
begin
  FCrit.Where('A', opEqual, 1);
  try
    FCrit.Where('B', opLike, 5);
    Fail('LIKE on a number must raise');
  except
    on E: EOPF do ;
  end;
  AssertEquals('Typed Where', 'A = :p1', FCrit.ToWhereSQL(Nil));
  try
    FCrit.WhereIn('B', [2, TObject(Nil)]);
    Fail('Unsupported value must raise');
  except
    on E: EOPF do ;
  end;
  AssertEquals('WhereIn', 'A = :p1', FCrit.ToWhereSQL(Nil));
  try
    FCrit.WhereBetween('B', [2]);
    Fail('Between with one value must raise');
  except
    on E: EOPF do ;
  end;
  AssertEquals('WhereBetween', 'A = :p1', FCrit.ToWhereSQL(Nil));
  AssertEquals('Parameters kept', 1, FCrit.Params.Count);
  AssertEquals('Value kept', 1, FCrit.Params[0].AsInteger);
  // The criteria still works normally afterwards
  FCrit.AddAnd('B', opEqual, 2);
  AssertEquals('Continues', 'A = :p1 AND B = :p2', FCrit.ToWhereSQL(Nil));
end;

procedure TTestCriteriaSafety.TestFailedWhereRawKeepsConditions;
begin
  FCrit.Where('A', opEqual, 1);
  try
    FCrit.WhereRaw('B = ? AND C = ?', [1]);
    Fail('Placeholder count mismatch must raise');
  except
    on E: EOPF do ;
  end;
  AssertEquals('Raw', 'A = :p1', FCrit.ToWhereSQL(Nil));
  // A successful Where still replaces the conditions
  FCrit.Where('B', opEqual, 2);
  AssertEquals('Replaced', 'B = :p1', FCrit.ToWhereSQL(Nil));
  AssertEquals('One parameter', 1, FCrit.Params.Count);
end;

procedure TTestCriteriaSafety.TestDateInArrayOfConstBoundAsDate;
var
  F: TOPFieldMap;
  D1, D2: TDateTime;
begin
  F:=FMap.Add as TOPFieldMap;
  F.PropertyName:='Born';
  F.FieldName:='born';
  F.PropertyKind:=tkFloat;
  F.PropertyTypeInfo:=TypeInfo(TDateTime);
  D1:=EncodeDate(2020, 1, 2);
  D2:=EncodeDate(2021, 3, 4);
  // TDateTime in an array of const arrives as vtExtended
  FCrit.WhereBetween('Born', [D1, D2]).AddOrIn('Born', [D1]).AddOr('Born', opEqual, Double(D2));
  FCrit.ToWhereSQL(FMap);
  AssertTrue('Low is a date', FCrit.Params[0].DataType=ftDateTime);
  AssertTrue('High is a date', FCrit.Params[1].DataType=ftDateTime);
  AssertTrue('IN value is a date', FCrit.Params[2].DataType=ftDateTime);
  AssertTrue('Comparison is a date', FCrit.Params[3].DataType=ftDateTime);
  AssertEquals('Value kept', D2, FCrit.Params[1].AsDateTime);
end;

procedure TTestCriteriaSafety.TestFloatInArrayOfConstStaysFloat;
var
  F: TOPFieldMap;
begin
  F:=FMap.Add as TOPFieldMap;
  F.PropertyName:='Price';
  F.FieldName:='price';
  F.PropertyKind:=tkFloat;
  F.PropertyTypeInfo:=TypeInfo(Double);
  FCrit.WhereBetween('Price', [1.5, 2.5]);
  FCrit.ToWhereSQL(FMap);
  AssertTrue('Float field keeps a float', FCrit.Params[0].DataType=ftFloat);
  // Without a field map nothing is known about the field
  FCrit.WhereIn('Price', [Double(EncodeDate(2020, 1, 2))]);
  FCrit.ToWhereSQL(Nil);
  AssertTrue('Unknown field keeps a float', FCrit.Params[0].DataType=ftFloat);
end;

{ ---------------------------------------------------------------------
  TTestLinqReuse
  ---------------------------------------------------------------------}

function SQLOf(const aExpr: TOPLinqExpr): UTF8String;
begin
  Result:=aExpr.FCtx.GetCriteria.ToWhereSQL(Nil);
end;

procedure TTestLinqReuse.TestOperandReusableAfterAnd;
var
  E, F: TOPLinqExpr;
begin
  E:=Prop('A')=1;
  F:=E and (Prop('B')=2);
  AssertEquals('Operand intact', 'A = :p1', SQLOf(E));
  AssertEquals('Result', 'A = :p1 AND (B = :p2)', SQLOf(F));
end;

procedure TTestLinqReuse.TestOperandReusableAfterOr;
var
  E, F, G: TOPLinqExpr;
begin
  E:=Prop('A')=1;
  F:=Prop('B')=2;
  G:=E or F;
  AssertEquals('Left intact', 'A = :p1', SQLOf(E));
  AssertEquals('Right intact', 'B = :p1', SQLOf(F));
  AssertEquals('Result', 'A = :p1 OR (B = :p2)', SQLOf(G));
end;

procedure TTestLinqReuse.TestSelfAnd;
var
  E, F: TOPLinqExpr;
begin
  E:=Prop('A')=1;
  F:=E and E;
  AssertEquals('E and E', 'A = :p1 AND (A = :p2)', SQLOf(F));
  AssertEquals('Two params', 2, F.FCtx.GetCriteria.Params.Count);
end;

procedure TTestLinqReuse.TestSelfOr;
var
  E, F: TOPLinqExpr;
begin
  E:=(Prop('A')=1) and (Prop('B')=2);
  F:=E or E;
  AssertEquals('E or E', '(A = :p1 AND (B = :p2)) OR (A = :p3 AND (B = :p4))', SQLOf(F));
end;

procedure TTestLinqReuse.TestNotKeepsOperand;
var
  E, N: TOPLinqExpr;
begin
  E:=Prop('A')=1;
  N:=not E;
  AssertEquals('Operand intact', 'A = :p1', SQLOf(E));
  AssertEquals('Negated', 'NOT (A = :p1)', SQLOf(N));
end;

procedure TTestLinqReuse.TestOrThenAndBracketed;
var
  E: TOPLinqExpr;
begin
  E:=((Prop('A')=1) or (Prop('B')=2)) and (Prop('C')=3);
  AssertEquals('(A OR B) AND C', '(A = :p1 OR (B = :p2)) AND (C = :p3)', SQLOf(E));
end;

procedure TTestLinqReuse.TestReuseInMultipleCombinations;
var
  E, F, G: TOPLinqExpr;
begin
  E:=Prop('A')=1;
  F:=Prop('B')=2;
  G:=(E and F) or E;
  AssertEquals('(E and F) or E', '(A = :p1 AND (B = :p2)) OR (A = :p3)', SQLOf(G));
  G:=(E or F) and (not E);
  AssertEquals('(E or F) and not E', '(A = :p1 OR (B = :p2)) AND (NOT (A = :p3))', SQLOf(G));
end;

procedure TTestLinqReuse.TestUnassignedLeftRaises;
var
  E, F, G: TOPLinqExpr;
begin
  E:=Default(TOPLinqExpr);
  F:=Prop('A')=1;
  try
    G:=E and F;
    Fail('Unassigned operand must raise');
  except
    on EOPF do ;
  end;
  AssertEquals('Right operand intact', 'A = :p1', SQLOf(F));
  if Assigned(G.FCtx) then ; // silence hint
end;

procedure TTestLinqReuse.TestUnassignedRightRaises;
var
  E, F, G: TOPLinqExpr;
begin
  E:=Prop('A')=1;
  F:=Default(TOPLinqExpr);
  try
    G:=E or F;
    Fail('Unassigned operand must raise');
  except
    on EOPF do ;
  end;
  AssertEquals('Left operand intact', 'A = :p1', SQLOf(E));
  if Assigned(G.FCtx) then ;
end;

procedure TTestLinqReuse.TestUnassignedNotRaises;
var
  E, G: TOPLinqExpr;
begin
  E:=Default(TOPLinqExpr);
  try
    G:=not E;
    Fail('Unassigned operand must raise');
  except
    on EOPF do ;
  end;
  if Assigned(G.FCtx) then ;
end;

