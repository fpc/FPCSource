    'UPDATE','USAGE','USE','USING','UTC_DATE','UTC_TIME','UTC_TIMESTAMP',
    'VALUE','VALUES','VARBINARY','VARCHAR','VARCHARACTER','VARYING','VIRTUAL',
    'WHEN','WHERE','WHILE','WINDOW','WITH','WRITE','XOR','YEAR_MONTH',
