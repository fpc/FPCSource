function TSQLDriverMySQL.GetDateTimeTypeSQL(aKind: TOPFloatKind): UTF8String;
begin
  // Millisecond precision; MySQL TIMESTAMP has a limited range and time zone handling
  case aKind of
    fkDate: Result:='DATE';
    fkTime: Result:='TIME(3)';
  else
    Result:='DATETIME(3)';
  end;
end;

