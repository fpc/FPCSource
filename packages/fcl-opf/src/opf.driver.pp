function TSQLDriverFirebird3.GetLimitOffsetSQL(aLimit, aOffset: Integer): UTF8String;
begin
  // Firebird 3+: OFFSET M ROWS FETCH NEXT N ROWS ONLY
  Result:='';
  if aOffset > 0 then
    Result:='OFFSET ' + IntToStr(aOffset) + ' ROWS';
  if aLimit > 0 then
  begin
    if Result <> '' then
      Result:=Result + ' ';
    Result:=Result + 'FETCH NEXT ' + IntToStr(aLimit) + ' ROWS ONLY';
  end;
end;

