{$modeswitch typehelpers}

interface

uses
{$IFDEF FPC_DOTTEDUNITS}
  System.Classes, System.SysUtils, System.TypInfo, Data.Db, Data.Sqldb,
{$ELSE}
  Classes, SysUtils, typinfo, db, sqldb,
{$ENDIF}
