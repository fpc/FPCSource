function TSQLDriverFirebird.GetLimitOffsetSQL(aLimit, aOffset: Integer): UTF8String;
begin
  // Firebird pre-3: ROWS M+1 TO M+N (1-based range)
  // Computed in Int64: offset+limit can exceed High(Integer)
  Result:='';
  if (aLimit > 0) and (aOffset > 0) then
    Result:='ROWS ' + IntToStr(Int64(aOffset) + 1) + ' TO ' + IntToStr(Int64(aOffset) + aLimit)
  else if aLimit > 0 then
    Result:='ROWS 1 TO ' + IntToStr(aLimit)
  else if aOffset > 0 then
    Result:='ROWS ' + IntToStr(Int64(aOffset) + 1) + ' TO ' + IntToStr(High(Int64));
end;

