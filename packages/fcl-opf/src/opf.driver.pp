function TSQLDriverSQLite.IntrospectSchema(aConnection: TSQLConnection): TOPSchemaInfo;
var
  Q, Q2: TSQLQuery;
  Schema: TOPSchemaInfo;
  TableCount, ColCount, FKCount, IdxCount, IdxColCount: Integer;
  TableName, IdxName, Origin: UTF8String;
  I: Integer;
begin
  Schema:=TOPSchemaInfo.Create;
  try
    Q:=TSQLQuery.Create(nil);
    try
      Q.Database:=aConnection;
      Q.Transaction:=aConnection.Transaction;

      // Get all user tables
      // _ is a LIKE wildcard: escape it
      Q.SQL.Text:='SELECT name FROM sqlite_master WHERE type=''table'' '+
        'AND name NOT LIKE ''sqlite\_%'' ESCAPE ''\'' AND name NOT LIKE ''\_opf\_%'' ESCAPE ''\'' ORDER BY name';
      Q.Open;
      TableCount:=0;
      while not Q.EOF do
      begin
        SetLength(Schema.Tables, TableCount+1);
        Schema.Tables[TableCount].TableName:=Q.Fields[0].AsString;
        Schema.Tables[TableCount].Columns:=nil;
        Schema.Tables[TableCount].PrimaryKey:=nil;
        Schema.Tables[TableCount].Indexes:=nil;
        Schema.Tables[TableCount].ForeignKeys:=nil;
        Inc(TableCount);
        Q.Next;
      end;
      Q.Close;

      Q2:=TSQLQuery.Create(nil);
      try
        Q2.Database:=aConnection;
        Q2.Transaction:=aConnection.Transaction;

        for I:=0 to TableCount-1 do
        begin
          TableName:=Schema.Tables[I].TableName;

          // Columns + primary key via PRAGMA table_info
          Q2.SQL.Text:='PRAGMA table_info('+QuoteIdentifier(TableName)+')';
          Q2.Open;
          ColCount:=0;
          while not Q2.EOF do
          begin
            SetLength(Schema.Tables[I].Columns, ColCount+1);
            Schema.Tables[I].Columns[ColCount].ColumnName:=Q2.FieldByName('name').AsString;
            Schema.Tables[I].Columns[ColCount].DataType:=Q2.FieldByName('type').AsString;
            Schema.Tables[I].Columns[ColCount].IsNullable:=(Q2.FieldByName('notnull').AsInteger=0);
            Schema.Tables[I].Columns[ColCount].DefaultValue:=Q2.FieldByName('dflt_value').AsString;
            Schema.Tables[I].Columns[ColCount].MaxLength:=0;
            // Primary key detection
            if Q2.FieldByName('pk').AsInteger>0 then
            begin
              SetLength(Schema.Tables[I].PrimaryKey, Length(Schema.Tables[I].PrimaryKey)+1);
              Schema.Tables[I].PrimaryKey[High(Schema.Tables[I].PrimaryKey)]:=Q2.FieldByName('name').AsString;
            end;
            Inc(ColCount);
            Q2.Next;
          end;
          Q2.Close;

          // Foreign keys via PRAGMA foreign_key_list
          Q2.SQL.Text:='PRAGMA foreign_key_list('+QuoteIdentifier(TableName)+')';
          Q2.Open;
          FKCount:=0;
          while not Q2.EOF do
          begin
            SetLength(Schema.Tables[I].ForeignKeys, FKCount+1);
            Schema.Tables[I].ForeignKeys[FKCount].ConstraintName:=
              'fk_'+LowerCase(TableName)+'_'+LowerCase(Q2.FieldByName('table').AsString);
            Schema.Tables[I].ForeignKeys[FKCount].ColumnName:=Q2.FieldByName('from').AsString;
            Schema.Tables[I].ForeignKeys[FKCount].ReferencedTable:=Q2.FieldByName('table').AsString;
            Schema.Tables[I].ForeignKeys[FKCount].ReferencedColumn:=Q2.FieldByName('to').AsString;
            Schema.Tables[I].ForeignKeys[FKCount].OnDelete:=Q2.FieldByName('on_delete').AsString;
            Inc(FKCount);
            Q2.Next;
          end;
          Q2.Close;

          // Indexes via PRAGMA index_list + PRAGMA index_info
          Q2.SQL.Text:='PRAGMA index_list('+QuoteIdentifier(TableName)+')';
          Q2.Open;
          IdxCount:=0;
          while not Q2.EOF do
          begin
            IdxName:=Q2.FieldByName('name').AsString;
            Origin:=Q2.FieldByName('origin').AsString;
            // Skip auto-generated PK and autoindex entries
            if (Origin='pk') then
            begin
              Q2.Next;
              Continue;
            end;
            SetLength(Schema.Tables[I].Indexes, IdxCount+1);
            Schema.Tables[I].Indexes[IdxCount].IndexName:=IdxName;
            Schema.Tables[I].Indexes[IdxCount].IsUnique:=(Q2.FieldByName('unique').AsInteger<>0);
            Schema.Tables[I].Indexes[IdxCount].Columns:=nil;

            // Get index columns
            Q.SQL.Text:='PRAGMA index_info('+QuoteIdentifier(IdxName)+')';
            Q.Open;
            IdxColCount:=0;
            while not Q.EOF do
            begin
              SetLength(Schema.Tables[I].Indexes[IdxCount].Columns, IdxColCount+1);
              Schema.Tables[I].Indexes[IdxCount].Columns[IdxColCount]:=Q.FieldByName('name').AsString;
              Inc(IdxColCount);
              Q.Next;
            end;
            Q.Close;

            Inc(IdxCount);
            Q2.Next;
          end;
          Q2.Close;
        end;
      finally
        Q2.Free;
      end;
    finally
      Q.Free;
    end;
  except
    Schema.Free;
    raise;
  end;
  Result:=Schema;
end;

