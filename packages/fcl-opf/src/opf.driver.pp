{ Only uses system tables and columns that exist since Firebird 2.5. In 2.5,
  RDB$SYSTEM_FLAG of user tables and indexes can be NULL. }

function TSQLDriverFirebird.IntrospectSchema(aConnection: TSQLConnection): TOPSchemaInfo;
var
  Q, Q2: TSQLQuery;
  Schema: TOPSchemaInfo;
  TableCount, ColCount, FKCount, IdxCount, IdxColCount: Integer;
  TableName, IdxName, PrevIdx, ConstraintType: UTF8String;
  I: Integer;
begin
  Schema:=TOPSchemaInfo.Create;
  try
    Q:=TSQLQuery.Create(nil);
    try
      Q.Database:=aConnection;
      Q.Transaction:=aConnection.Transaction;

      // Get all user tables
      // Internal tables: _OPF_ unquoted, or "_opf_..." when created quoted
      Q.SQL.Text:='SELECT TRIM(RDB$RELATION_NAME) FROM RDB$RELATIONS '+
        'WHERE COALESCE(RDB$SYSTEM_FLAG,0)=0 AND RDB$VIEW_BLR IS NULL '+
        'AND UPPER(TRIM(RDB$RELATION_NAME)) NOT STARTING WITH ''_OPF_'' '+
        'ORDER BY RDB$RELATION_NAME';
      Q.Open;
      TableCount:=0;
      while not Q.EOF do
      begin
        SetLength(Schema.Tables, TableCount+1);
        Schema.Tables[TableCount].TableName:=Trim(Q.Fields[0].AsString);
        Schema.Tables[TableCount].Columns:=nil;
        Schema.Tables[TableCount].PrimaryKey:=nil;
        Schema.Tables[TableCount].Indexes:=nil;
        Schema.Tables[TableCount].ForeignKeys:=nil;
        Inc(TableCount);
        Q.Next;
      end;
      Q.Close;

      Q2:=TSQLQuery.Create(nil);
      try
        Q2.Database:=aConnection;
        Q2.Transaction:=aConnection.Transaction;

        for I:=0 to TableCount-1 do
        begin
          TableName:=Schema.Tables[I].TableName;

          // Columns
          // Exact numerics are stored as integer types with a sub type or a scale.
          // NOT NULL can be set on the column or on its domain.
          Q2.SQL.Text:='SELECT TRIM(rf.RDB$FIELD_NAME) AS col_name, '+
            'TRIM(CASE '+
            'WHEN f.RDB$FIELD_TYPE IN (7,8,16,26) AND (COALESCE(f.RDB$FIELD_SUB_TYPE,0) IN (1,2) '+
            '  OR COALESCE(f.RDB$FIELD_SCALE,0)<0) THEN '+
            '  (CASE f.RDB$FIELD_SUB_TYPE WHEN 1 THEN ''NUMERIC'' ELSE ''DECIMAL'' END) '+
            'WHEN f.RDB$FIELD_TYPE=261 AND COALESCE(f.RDB$FIELD_SUB_TYPE,0)=1 THEN ''BLOB SUB_TYPE 1'' '+
            'ELSE (CASE f.RDB$FIELD_TYPE '+
            'WHEN 7 THEN ''SMALLINT'' WHEN 8 THEN ''INTEGER'' WHEN 16 THEN ''BIGINT'' '+
            'WHEN 26 THEN ''INT128'' '+
            'WHEN 10 THEN ''FLOAT'' WHEN 27 THEN ''DOUBLE PRECISION'' '+
            'WHEN 24 THEN ''DECFLOAT'' WHEN 25 THEN ''DECFLOAT'' '+
            'WHEN 37 THEN ''VARCHAR'' WHEN 14 THEN ''CHAR'' '+
            'WHEN 12 THEN ''DATE'' WHEN 13 THEN ''TIME'' WHEN 35 THEN ''TIMESTAMP'' '+
            'WHEN 28 THEN ''TIME WITH TIME ZONE'' WHEN 29 THEN ''TIMESTAMP WITH TIME ZONE'' '+
            'WHEN 261 THEN ''BLOB'' WHEN 23 THEN ''BOOLEAN'' '+
            'ELSE CAST(f.RDB$FIELD_TYPE AS VARCHAR(20)) END) END) AS data_type, '+
            'CASE WHEN COALESCE(rf.RDB$NULL_FLAG,f.RDB$NULL_FLAG,0)=1 THEN 0 ELSE 1 END AS is_nullable, '+
            'COALESCE(rf.RDB$DEFAULT_SOURCE,'''') AS dflt_value, '+
            'COALESCE(f.RDB$CHARACTER_LENGTH,0) AS max_len, '+
            'COALESCE(f.RDB$FIELD_PRECISION,0) AS num_prec, '+
            '-COALESCE(f.RDB$FIELD_SCALE,0) AS num_scale '+
            'FROM RDB$RELATION_FIELDS rf '+
            'JOIN RDB$FIELDS f ON rf.RDB$FIELD_SOURCE=f.RDB$FIELD_NAME '+
            'WHERE rf.RDB$RELATION_NAME='+QuotedStr(TableName)+' '+
            'ORDER BY rf.RDB$FIELD_POSITION';
          Q2.Open;
          ColCount:=0;
          while not Q2.EOF do
          begin
            SetLength(Schema.Tables[I].Columns, ColCount+1);
            Schema.Tables[I].Columns[ColCount].ColumnName:=Trim(Q2.FieldByName('col_name').AsString);
            Schema.Tables[I].Columns[ColCount].DataType:=Trim(Q2.FieldByName('data_type').AsString);
            Schema.Tables[I].Columns[ColCount].IsNullable:=(Q2.FieldByName('is_nullable').AsInteger=1);
            Schema.Tables[I].Columns[ColCount].DefaultValue:=Trim(Q2.FieldByName('dflt_value').AsString);
            Schema.Tables[I].Columns[ColCount].MaxLength:=Q2.FieldByName('max_len').AsInteger;
            Schema.Tables[I].Columns[ColCount].NumericPrecision:=Q2.FieldByName('num_prec').AsInteger;
            Schema.Tables[I].Columns[ColCount].NumericScale:=Q2.FieldByName('num_scale').AsInteger;
            Inc(ColCount);
            Q2.Next;
          end;
          Q2.Close;

          // Primary key
          Q2.SQL.Text:='SELECT TRIM(sg.RDB$FIELD_NAME) FROM RDB$RELATION_CONSTRAINTS rc '+
            'JOIN RDB$INDEX_SEGMENTS sg ON rc.RDB$INDEX_NAME=sg.RDB$INDEX_NAME '+
            'WHERE rc.RDB$RELATION_NAME='+QuotedStr(TableName)+' '+
            'AND rc.RDB$CONSTRAINT_TYPE=''PRIMARY KEY'' '+
            'ORDER BY sg.RDB$FIELD_POSITION';
          Q2.Open;
          while not Q2.EOF do
          begin
            SetLength(Schema.Tables[I].PrimaryKey, Length(Schema.Tables[I].PrimaryKey)+1);
            Schema.Tables[I].PrimaryKey[High(Schema.Tables[I].PrimaryKey)]:=Trim(Q2.Fields[0].AsString);
            Q2.Next;
          end;
          Q2.Close;

          // Foreign keys
          Q2.SQL.Text:='SELECT TRIM(rc.RDB$CONSTRAINT_NAME) AS fk_name, '+
            'TRIM(sg.RDB$FIELD_NAME) AS fk_col, '+
            'TRIM(rc2.RDB$RELATION_NAME) AS ref_table, '+
            'TRIM(sg2.RDB$FIELD_NAME) AS ref_col, '+
            'TRIM(refc.RDB$DELETE_RULE) AS del_rule '+
            'FROM RDB$RELATION_CONSTRAINTS rc '+
            'JOIN RDB$INDEX_SEGMENTS sg ON rc.RDB$INDEX_NAME=sg.RDB$INDEX_NAME '+
            'JOIN RDB$REF_CONSTRAINTS refc ON rc.RDB$CONSTRAINT_NAME=refc.RDB$CONSTRAINT_NAME '+
            'JOIN RDB$RELATION_CONSTRAINTS rc2 ON refc.RDB$CONST_NAME_UQ=rc2.RDB$CONSTRAINT_NAME '+
            'JOIN RDB$INDEX_SEGMENTS sg2 ON rc2.RDB$INDEX_NAME=sg2.RDB$INDEX_NAME '+
            'AND sg.RDB$FIELD_POSITION=sg2.RDB$FIELD_POSITION '+
            'WHERE rc.RDB$RELATION_NAME='+QuotedStr(TableName)+' '+
            'AND rc.RDB$CONSTRAINT_TYPE=''FOREIGN KEY''';
          Q2.Open;
          FKCount:=0;
          while not Q2.EOF do
          begin
            SetLength(Schema.Tables[I].ForeignKeys, FKCount+1);
            Schema.Tables[I].ForeignKeys[FKCount].ConstraintName:=Trim(Q2.FieldByName('fk_name').AsString);
            Schema.Tables[I].ForeignKeys[FKCount].ColumnName:=Trim(Q2.FieldByName('fk_col').AsString);
            Schema.Tables[I].ForeignKeys[FKCount].ReferencedTable:=Trim(Q2.FieldByName('ref_table').AsString);
            Schema.Tables[I].ForeignKeys[FKCount].ReferencedColumn:=Trim(Q2.FieldByName('ref_col').AsString);
            Schema.Tables[I].ForeignKeys[FKCount].OnDelete:=Trim(Q2.FieldByName('del_rule').AsString);
            Inc(FKCount);
            Q2.Next;
          end;
          Q2.Close;

          // Indexes (skip system and PK/FK indexes)
          Q2.SQL.Text:='SELECT TRIM(idx.RDB$INDEX_NAME) AS idx_name, '+
            'idx.RDB$UNIQUE_FLAG AS is_unique, '+
            'TRIM(sg.RDB$FIELD_NAME) AS col_name '+
            'FROM RDB$INDICES idx '+
            'JOIN RDB$INDEX_SEGMENTS sg ON idx.RDB$INDEX_NAME=sg.RDB$INDEX_NAME '+
            'WHERE idx.RDB$RELATION_NAME='+QuotedStr(TableName)+' '+
            'AND COALESCE(idx.RDB$SYSTEM_FLAG,0)=0 '+
            'AND NOT EXISTS (SELECT 1 FROM RDB$RELATION_CONSTRAINTS rc '+
            '  WHERE rc.RDB$INDEX_NAME=idx.RDB$INDEX_NAME) '+
            'ORDER BY idx.RDB$INDEX_NAME, sg.RDB$FIELD_POSITION';
          Q2.Open;
          IdxCount:=0;
          PrevIdx:='';
          while not Q2.EOF do
          begin
            IdxName:=Trim(Q2.FieldByName('idx_name').AsString);
            if IdxName<>PrevIdx then
            begin
              SetLength(Schema.Tables[I].Indexes, IdxCount+1);
              Schema.Tables[I].Indexes[IdxCount].IndexName:=IdxName;
              Schema.Tables[I].Indexes[IdxCount].IsUnique:=(Q2.FieldByName('is_unique').AsInteger=1);
              Schema.Tables[I].Indexes[IdxCount].Columns:=nil;
              PrevIdx:=IdxName;
              Inc(IdxCount);
            end;
            SetLength(Schema.Tables[I].Indexes[IdxCount-1].Columns,
              Length(Schema.Tables[I].Indexes[IdxCount-1].Columns)+1);
            Schema.Tables[I].Indexes[IdxCount-1].Columns[
              High(Schema.Tables[I].Indexes[IdxCount-1].Columns)]:=Trim(Q2.FieldByName('col_name').AsString);
            Q2.Next;
          end;
          Q2.Close;
        end;
      finally
        Q2.Free;
      end;
    finally
      Q.Free;
    end;
  except
    Schema.Free;
    raise;
  end;
  Result:=Schema;
end;

