function TSQLDriverSQLServer.GetStringTypeSQL(aFixed: Boolean; aLength: Integer): UTF8String;
begin
  if not FUnicodeStrings then
    Exit('');
  // NCHAR/NVARCHAR take at most 4000 characters
  if aLength>4000 then
    Result:='NVARCHAR(MAX)'
  else if aFixed then
    Result:='NCHAR('+IntToStr(aLength)+')'
  else
    Result:='NVARCHAR('+IntToStr(aLength)+')';
end;

function TSQLDriverSQLServer.GetAutoIncColumnSQL(const aQuotedName: UTF8String; aIs64Bit: Boolean): UTF8String;
begin
  if aIs64Bit then
    Result:=aQuotedName+' BIGINT IDENTITY(1,1) PRIMARY KEY'
  else
    Result:=aQuotedName+' INT IDENTITY(1,1) PRIMARY KEY';
end;

