{ Dialect of a connection, by class (TSQLConnector: by proxy or connector type).
  For an open Firebird connection, the server version selects dFirebird3.
  Never opens the connection and never executes a query. }
Function DetectDialectFromConnection(aConnection: TSQLConnection): TSQLDialect;
// Dialect matching the class name of a connection
Function DetectDialectFromClassName(const aClassName: String): TSQLDialect;
// Dialect matching the connector type name of a TSQLConnector
Function DetectDialectFromConnectorType(const aConnectorType: String): TSQLDialect;
// dFirebird3 for server major version 3 and higher, dFirebird otherwise
Function DialectFromFirebirdVersion(const aVersion: String): TSQLDialect;

// 8 hex digit hash (FNV-1a) of aName: a stable suffix for generated names
Function OPFNameHash(const aName: UTF8String): UTF8String;
// aName if it fits in aMaxLength (0: no limit), otherwise a truncated name
// followed by '_' and the hash of the full name
Function OPFShortenIdentifier(const aName: UTF8String; aMaxLength: Integer): UTF8String;

Const
  SQLKeyWords : Array[TSQLKeyWord] of UTF8String = (
    '','SELECT','FROM','INSERT','INTO','VALUES','UPDATE','SET','WHERE','AND','CREATE','TABLE','CONSTRAINT','PRIMARY KEY','NOT','NULL',
    'INT','SMALLINT','BIGINT','CHAR','VARCHAR','FLOAT','DECIMAL','BOOLEAN','BIT','BLOB','MEMO','BYTEA','SUB_TYPE','CLOB','TEXT','DELETE',
    'ALTER','DROP','ADD','COLUMN','FOREIGN','KEY','REFERENCES','CASCADE','UNIQUE','INDEX','ON','DEFAULT',
    'TRUE','FALSE'
  );

implementation

uses
  Opf.Types, Opf.Consts;

function OPFNameHash(const aName: UTF8String): UTF8String;
var
  H: Cardinal;
  I: Integer;
begin
  H:=2166136261;
  for I:=1 to Length(aName) do
  begin
    H:=H xor Ord(aName[I]);
    {$PUSH}{$Q-}{$R-}
    H:=H*16777619;
    {$POP}
  end;
  Result:=LowerCase(IntToHex(H, 8));
end;

function OPFShortenIdentifier(const aName: UTF8String; aMaxLength: Integer): UTF8String;
var
  Len: Integer;
begin
  if (aMaxLength<=0) or (Length(aName)<=aMaxLength) then
    Exit(aName);
  // 9 = '_' + 8 hash digits
  Len:=aMaxLength-9;
  // Do not cut a UTF-8 sequence in two
  while (Len>0) and ((Ord(aName[Len+1]) and $C0)=$80) do
    Dec(Len);
  Result:=Copy(aName, 1, Len) + '_' + OPFNameHash(aName);
end;

function DetectDialectFromClassName(const aClassName: String): TSQLDialect;
var
  CN: String;
begin
  CN:=UpperCase(aClassName);
  if Pos('SQLITE', CN) > 0 then
    Result:=dSQLite
  else if Pos('PQCONNECTION', CN) > 0 then
    Result:=dPostGres
  else if (Pos('FIREBIRD', CN) > 0) or (Pos('IBCONNECTION', CN) > 0) then
    Result:=dFirebird
  else if Pos('MYSQL', CN) > 0 then
    Result:=dMySQL
  else if Pos('MSSQL', CN) > 0 then
    Result:=dSQLServer
  else if Pos('ORACLE', CN) > 0 then
    Result:=dOracle
  else
    Result:=dVanilla;
end;

function DetectDialectFromConnectorType(const aConnectorType: String): TSQLDialect;
var
  CT: String;
begin
  CT:=UpperCase(Trim(aConnectorType));
  if Pos('SQLITE', CT) = 1 then
    Result:=dSQLite
  else if (CT = 'POSTGRESQL') or (CT = 'POSTGRES') then
    Result:=dPostGres
  else if (CT = 'FIREBIRD') or (CT = 'INTERBASE') then
    Result:=dFirebird
  else if Pos('MYSQL', CT) = 1 then
    Result:=dMySQL
  else if Pos('MSSQL', CT) = 1 then
    Result:=dSQLServer
  else if Pos('ORACLE', CT) = 1 then
    Result:=dOracle
  else
    Result:=dVanilla;
end;

{ Accepted forms:
  - the server version string: 'LI-V4.0.6.3221 Firebird 4.0' (the number
    after 'Firebird' is used; without 'Firebird' it is InterBase)
  - a dotted version: '3.0.10'
  - the zero-padded form of TIBConnection.GetConnectionInfo(citServerVersion):
    '040006', two digits per number }

function DialectFromFirebirdVersion(const aVersion: String): TSQLDialect;
var
  S: String;
  I, P, Major: Integer;
begin
  Result:=dFirebird;
  S:=Trim(aVersion);
  P:=Pos('FIREBIRD', UpperCase(S));
  if P>0 then
    S:=Trim(Copy(S, P+8, Length(S)))
  else if Pos(' ', S)>0 then
    Exit; // A version string that does not mention Firebird: InterBase
  // Zero-padded: all digits, two per number
  if (Length(S)>=4) and (Length(S) mod 2=0) then
  begin
    I:=1;
    while (I<=Length(S)) and (S[I] in ['0'..'9']) do
      Inc(I);
    if I>Length(S) then
    begin
      if StrToIntDef(Copy(S, 1, 2), 0)>=3 then
        Result:=dFirebird3;
      Exit;
    end;
  end;
  I:=1;
  while (I<=Length(S)) and not (S[I] in ['0'..'9']) do
    Inc(I);
  Major:=0;
  while (I<=Length(S)) and (S[I] in ['0'..'9']) do
  begin
    Major:=Major*10+Ord(S[I])-Ord('0');
    Inc(I);
  end;
  if Major>=3 then
    Result:=dFirebird3;
end;

type
  // Access to the protected Proxy property
  TSQLConnectorAccess = class(TSQLConnector);

function DetectDialectFromConnection(aConnection: TSQLConnection): TSQLDialect;
var
  Conn: TSQLConnection;
  Version: String;
begin
  Result:=dVanilla;
  if aConnection=Nil then
    Exit;
  Conn:=aConnection;
  // A connector delegates to a proxy connection of the real type
  if Conn is TSQLConnector then
  begin
    if TSQLConnectorAccess(Conn).Proxy<>Nil then
      Conn:=TSQLConnectorAccess(Conn).Proxy
    else
      Exit(DetectDialectFromConnectorType(TSQLConnector(Conn).ConnectorType));
  end;
  Result:=DetectDialectFromClassName(Conn.ClassName);
  // The server version is known once connected; no query is needed.
  if (Result=dFirebird) and Conn.Connected then
  begin
    // The complete string, e.g. 'LI-V4.0.6.3221 Firebird 4.0'
    try
      Version:=Conn.GetConnectionInfo(citServerVersionString);
      if Version='' then
        Version:=Conn.GetConnectionInfo(citServerVersion);
    except
      Version:='';
    end;
    if Version<>'' then
      Result:=DialectFromFirebirdVersion(Version);
  end;
end;

