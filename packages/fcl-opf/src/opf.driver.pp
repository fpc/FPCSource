function TSQLDriver.TransformIdentifier(const aIdentifier: UTF8String): UTF8String;
begin
  case FReservedWordStrategy of
    rwsNone:
      Result:=aIdentifier;
    rwsAppendChar:
      if IsReservedWord(aIdentifier) then
        Result:=aIdentifier+'_'
      else
        Result:=aIdentifier;
    rwsQuoteOnDemand:
      if IsReservedWord(aIdentifier) then
        Result:=QuoteIdentifier(aIdentifier)
      else
        Result:=aIdentifier;
    rwsAlwaysQuote:
      Result:=QuoteIdentifier(aIdentifier);
  else
    Result:=aIdentifier;
  end;
end;

