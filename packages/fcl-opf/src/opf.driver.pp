destructor TSQLDriver.Destroy;
begin
  FreeAndNil(FReservedWordCache);
  inherited Destroy;
end;

procedure TSQLDriver.EnsureReservedWordCache;
var
  Words: TUTF8StringArray;
  W: UTF8String;
  L: TStringList;
begin
  if FReservedWordCache<>Nil then
    Exit;
  // Filled before it is published: a driver can be shared between threads
  L:=TStringList.Create;
  L.CaseSensitive:=False;
  L.Sorted:=True;
  L.Duplicates:=dupIgnore;
  Words:=GetReservedWords;
  for W in Words do
    L.Add(W);
  EnterCriticalSection(OPFSingletonLock);
  try
    if FReservedWordCache=Nil then
    begin
      FReservedWordCache:=L;
      L:=Nil;
    end;
  finally
    LeaveCriticalSection(OPFSingletonLock);
  end;
  L.Free;
end;

class function TSQLDriver.CreateDriver(aDialect: TSQLDialect): TSQLDriver;
var
  C: TSQLDriverClass;
begin
  C:=FDriverRegistry[aDialect];
  if C<>Nil then
    Result:=C.Create(aDialect)
  else
    case aDialect of
      dVanilla:   Result:=TSQLDriverVanilla.Create(aDialect);
      dSQLite:    Result:=TSQLDriverSQLite.Create(aDialect);
      dMySQL:     Result:=TSQLDriverMySQL.Create(aDialect);
      dPostGres:  Result:=TSQLDriverPostgreSQL.Create(aDialect);
      dFirebird:  Result:=TSQLDriverFirebird.Create(aDialect);
      dFirebird3: Result:=TSQLDriverFirebird3.Create(aDialect);
      dSQLServer: Result:=TSQLDriverSQLServer.Create(aDialect);
      dOracle:    Result:=TSQLDriverOracle.Create(aDialect);
    else
      Result:=TSQLDriver.Create(aDialect);
    end;
end;

