procedure TSQLDriver.ValidateIdentifier(const aIdentifier: UTF8String);
var
  P: UTF8String;
begin
  if aIdentifier='' then
    raise EOPF.CreateFmt(SErrUnsafeIdentifier, [aIdentifier]);
  for P in GetUnsafeIdentifierPatterns do
    if Pos(P,aIdentifier)>0 then
      raise EOPF.CreateFmt(SErrUnsafeIdentifier, [aIdentifier]);
end;

function TSQLDriver.IsRegularIdentifier(const aIdentifier: UTF8String): Boolean;
var
  I: Integer;
begin
  Result:=False;
  if (aIdentifier='') or not (aIdentifier[1] in ['A'..'Z','a'..'z','_']) then
    Exit;
  for I:=2 to Length(aIdentifier) do
    if not (aIdentifier[I] in ['A'..'Z','a'..'z','0'..'9','_','$']) then
      Exit;
  Result:=True;
end;

function TSQLDriver.FormatIdentifier(const aIdentifier: UTF8String; aForceQuote: Boolean): UTF8String;
begin
  ValidateIdentifier(aIdentifier);
  if aForceQuote then
    Exit(QuoteIdentifier(aIdentifier));
  Result:=TransformIdentifier(aIdentifier);
  if (Result=aIdentifier) and not IsRegularIdentifier(aIdentifier) then
    Result:=QuoteIdentifier(aIdentifier);
end;

function TSQLDriver.FormatQualifiedIdentifier(const aName: UTF8String): UTF8String;
var
  P: Integer;
  Rest: UTF8String;
begin
  Result:='';
  Rest:=aName;
  P:=Pos('.', Rest);
  while P>0 do
  begin
    Result:=Result + FormatIdentifier(Copy(Rest, 1, P-1), False) + '.';
    Delete(Rest, 1, P);
    P:=Pos('.', Rest);
  end;
  Result:=Result + FormatIdentifier(Rest, False);
end;

function TSQLDriver.GetLimitOffsetSQL(aLimit, aOffset: Integer): UTF8String;
begin
  // Default: LIMIT N OFFSET M - works for SQLite, PostgreSQL, MySQL
  Result:='';
  if aLimit > 0 then
    Result:='LIMIT ' + IntToStr(aLimit)
  else if aOffset > 0 then
    Result:=GetNoLimitSQL;
  if aOffset > 0 then
  begin
    if Result <> '' then
      Result:=Result + ' ';
    Result:=Result + 'OFFSET ' + IntToStr(aOffset);
  end;
end;

