function TSQLDriverPostgreSQL.IntrospectSchema(aConnection: TSQLConnection): TOPSchemaInfo;
var
  Q, Q2: TSQLQuery;
  Schema: TOPSchemaInfo;
  TableCount, ColCount, FKCount, IdxCount: Integer;
  TableName, IdxName, PrevIdx: UTF8String;
  I: Integer;
begin
  Schema:=TOPSchemaInfo.Create;
  try
    Q:=TSQLQuery.Create(nil);
    try
      Q.Database:=aConnection;
      Q.Transaction:=aConnection.Transaction;

      // Get all user tables in the current schema (the first one of the search_path)
      // _ is a LIKE wildcard: escape it
      Q.SQL.Text:='SELECT table_name FROM information_schema.tables '+
        'WHERE table_schema=current_schema() AND table_type=''BASE TABLE'' '+
        'AND lower(table_name) NOT LIKE ''\_opf\_%'' ESCAPE ''\'' ORDER BY table_name';
      Q.Open;
      TableCount:=0;
      while not Q.EOF do
      begin
        SetLength(Schema.Tables, TableCount+1);
        Schema.Tables[TableCount].TableName:=Q.Fields[0].AsString;
        Schema.Tables[TableCount].Columns:=nil;
        Schema.Tables[TableCount].PrimaryKey:=nil;
        Schema.Tables[TableCount].Indexes:=nil;
        Schema.Tables[TableCount].ForeignKeys:=nil;
        Inc(TableCount);
        Q.Next;
      end;
      Q.Close;

      Q2:=TSQLQuery.Create(nil);
      try
        Q2.Database:=aConnection;
        Q2.Transaction:=aConnection.Transaction;

        for I:=0 to TableCount-1 do
        begin
          TableName:=Schema.Tables[I].TableName;

          // Columns
          Q2.SQL.Text:='SELECT column_name, data_type, is_nullable, column_default, '+
            'character_maximum_length, numeric_precision, numeric_scale '+
            'FROM information_schema.columns '+
            'WHERE table_schema=current_schema() AND table_name='+QuotedStr(TableName)+' '+
            'ORDER BY ordinal_position';
          Q2.Open;
          ColCount:=0;
          while not Q2.EOF do
          begin
            SetLength(Schema.Tables[I].Columns, ColCount+1);
            Schema.Tables[I].Columns[ColCount].ColumnName:=Q2.FieldByName('column_name').AsString;
            Schema.Tables[I].Columns[ColCount].DataType:=Q2.FieldByName('data_type').AsString;
            Schema.Tables[I].Columns[ColCount].IsNullable:=(Q2.FieldByName('is_nullable').AsString='YES');
            Schema.Tables[I].Columns[ColCount].DefaultValue:=Q2.FieldByName('column_default').AsString;
            Schema.Tables[I].Columns[ColCount].MaxLength:=Q2.FieldByName('character_maximum_length').AsInteger;
            Schema.Tables[I].Columns[ColCount].NumericPrecision:=Q2.FieldByName('numeric_precision').AsInteger;
            Schema.Tables[I].Columns[ColCount].NumericScale:=Q2.FieldByName('numeric_scale').AsInteger;
            Inc(ColCount);
            Q2.Next;
          end;
          Q2.Close;

          // Primary key (join on the table too: constraint names are per table)
          Q2.SQL.Text:='SELECT kcu.column_name FROM information_schema.table_constraints tc '+
            'JOIN information_schema.key_column_usage kcu '+
            'ON tc.constraint_name=kcu.constraint_name AND tc.table_schema=kcu.table_schema '+
            'AND tc.table_name=kcu.table_name '+
            'WHERE tc.table_schema=current_schema() AND tc.table_name='+QuotedStr(TableName)+' '+
            'AND tc.constraint_type=''PRIMARY KEY'' ORDER BY kcu.ordinal_position';
          Q2.Open;
          while not Q2.EOF do
          begin
            SetLength(Schema.Tables[I].PrimaryKey, Length(Schema.Tables[I].PrimaryKey)+1);
            Schema.Tables[I].PrimaryKey[High(Schema.Tables[I].PrimaryKey)]:=Q2.Fields[0].AsString;
            Q2.Next;
          end;
          Q2.Close;

          // Foreign keys. Constraint names are only unique per table in PostgreSQL,
          // so information_schema joins by name can mix up tables: use pg_constraint.
          Q2.SQL.Text:='SELECT c.conname AS constraint_name, a.attname AS column_name, '+
            'rt.relname AS ref_table, ra.attname AS ref_column, '+
            'CASE c.confdeltype WHEN ''c'' THEN ''CASCADE'' WHEN ''n'' THEN ''SET NULL'' '+
            '  WHEN ''d'' THEN ''SET DEFAULT'' WHEN ''r'' THEN ''RESTRICT'' ELSE ''NO ACTION'' END AS delete_rule '+
            'FROM pg_catalog.pg_constraint c '+
            'JOIN pg_catalog.pg_class t ON t.oid=c.conrelid '+
            'JOIN pg_catalog.pg_namespace n ON n.oid=t.relnamespace '+
            'JOIN pg_catalog.pg_class rt ON rt.oid=c.confrelid '+
            'JOIN pg_catalog.pg_attribute a ON a.attrelid=c.conrelid AND a.attnum=c.conkey[1] '+
            'JOIN pg_catalog.pg_attribute ra ON ra.attrelid=c.confrelid AND ra.attnum=c.confkey[1] '+
            'WHERE c.contype=''f'' AND n.nspname=current_schema() AND t.relname='+QuotedStr(TableName);
          Q2.Open;
          FKCount:=0;
          while not Q2.EOF do
          begin
            SetLength(Schema.Tables[I].ForeignKeys, FKCount+1);
            Schema.Tables[I].ForeignKeys[FKCount].ConstraintName:=Q2.FieldByName('constraint_name').AsString;
            Schema.Tables[I].ForeignKeys[FKCount].ColumnName:=Q2.FieldByName('column_name').AsString;
            Schema.Tables[I].ForeignKeys[FKCount].ReferencedTable:=Q2.FieldByName('ref_table').AsString;
            Schema.Tables[I].ForeignKeys[FKCount].ReferencedColumn:=Q2.FieldByName('ref_column').AsString;
            Schema.Tables[I].ForeignKeys[FKCount].OnDelete:=Q2.FieldByName('delete_rule').AsString;
            Inc(FKCount);
            Q2.Next;
          end;
          Q2.Close;

          // Indexes (skip PK/unique-constraint indexes, use pg_catalog for reliable column names)
          Q2.SQL.Text:='SELECT ic.relname AS index_name, ix.indisunique AS is_unique, '+
            'a.attname AS col_name '+
            'FROM pg_catalog.pg_index ix '+
            'JOIN pg_catalog.pg_class tc ON ix.indrelid=tc.oid '+
            'JOIN pg_catalog.pg_class ic ON ix.indexrelid=ic.oid '+
            'JOIN pg_catalog.pg_namespace ns ON tc.relnamespace=ns.oid '+
            'JOIN pg_catalog.pg_attribute a ON a.attrelid=tc.oid AND a.attnum=ANY(ix.indkey) '+
            'WHERE ns.nspname=current_schema() AND tc.relname='+QuotedStr(TableName)+' '+
            'AND NOT ix.indisprimary '+
            'AND NOT EXISTS (SELECT 1 FROM pg_catalog.pg_constraint c '+
            '  WHERE c.conindid=ix.indexrelid AND c.contype IN (''p'',''u'')) '+
            'ORDER BY ic.relname, array_position(ix.indkey, a.attnum)';
          Q2.Open;
          IdxCount:=0;
          PrevIdx:='';
          while not Q2.EOF do
          begin
            IdxName:=Q2.FieldByName('index_name').AsString;
            if IdxName<>PrevIdx then
            begin
              SetLength(Schema.Tables[I].Indexes, IdxCount+1);
              Schema.Tables[I].Indexes[IdxCount].IndexName:=IdxName;
              Schema.Tables[I].Indexes[IdxCount].IsUnique:=Q2.FieldByName('is_unique').AsBoolean;
              Schema.Tables[I].Indexes[IdxCount].Columns:=nil;
              PrevIdx:=IdxName;
              Inc(IdxCount);
            end;
            SetLength(Schema.Tables[I].Indexes[IdxCount-1].Columns,
              Length(Schema.Tables[I].Indexes[IdxCount-1].Columns)+1);
            Schema.Tables[I].Indexes[IdxCount-1].Columns[
              High(Schema.Tables[I].Indexes[IdxCount-1].Columns)]:=Q2.FieldByName('col_name').AsString;
            Q2.Next;
          end;
          Q2.Close;
        end;
      finally
        Q2.Free;
      end;
    finally
      Q.Free;
    end;
  except
    Schema.Free;
    raise;
  end;
  Result:=Schema;
end;

