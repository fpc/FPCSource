Type

  TSQLKeyWord = (kwNone,kwSelect,kwFrom,kwInsert,kwInto,kwValues,kwUpdate,kwSet,kwWhere,kwAnd,kwCreate,kwTable,kwConstraint,
                 kwPrimaryKey,kwNot,kwNull,kwINT,kwSmallInt,kwBigInt,kwChar,kwVarchar,kwFloat,kwDecimal,kwBoolean,kwBit,kwBlob,
                 kwMemo,kwByteA, kwSubtype, kwClob, kwText, kwDelete,
                 kwAlter, kwDrop, kwAdd, kwColumn, kwForeign, kwKey, kwReferences, kwCascade, kwUnique, kwIndex, kwOn, kwDefault,
                 kwTrue, kwFalse);

  TSQLDialect = (dVanilla,dFirebird,dFirebird3,dPostGres,dSQLServer,dMySQL,dOracle,dSQLite);
  TSQLDialects = set of TSQLDialect;

  TReservedWordStrategy = (rwsNone, rwsAppendChar, rwsQuoteOnDemand, rwsAlwaysQuote);

  { How the key generated by an auto-increment column is returned:
    airNone: not possible (inserting such a row raises)
    airReturning: INSERT ... RETURNING, opened as a result set
    airPostQuery: a query after the INSERT (GetPostInsertValueSQL)
    airSameBatch: the INSERT and a SELECT of the key in one statement (SQL Server)
    airReturningInto: RETURNING ... INTO an output parameter (Oracle) }
  TOPAutoIncRetrieval = (airNone, airReturning, airPostQuery, airSameBatch, airReturningInto);

  TSQLDriver = Class;
  TSQLDriverClass = Class of TSQLDriver;

  { TSQLDriver }

  TSQLDriver = Class(TObject)
  private
    class var FDriverRegistry: array[TSQLDialect] of TSQLDriverClass;
  private
    FDialect: TSQLDialect;
    FQuoteChar: String;
    FReservedWordStrategy: TReservedWordStrategy;
    FReservedWordCache: TStringList;
    procedure EnsureReservedWordCache;
  public
    // Creates a driver for the given database dialect
    Constructor Create(aDialect: TSQLDialect); virtual;
    // Frees the driver and its cached list of reserved words
    Destructor Destroy; override;

    // Creates the driver registered for the given database dialect
    class function CreateDriver(aDialect: TSQLDialect): TSQLDriver;
    // Registers the driver class to use for a dialect, replacing the built-in one
    class procedure RegisterDriver(aDialect: TSQLDialect; aClass: TSQLDriverClass);

    // True if the database can return generated keys directly from an insert
    function SupportsReturningClause: Boolean; virtual;
    // Query that fetches the key generated by the last insert, empty if there is none
    function GetPostInsertValueSQL: UTF8String; virtual;
    { airSameBatch: statement that undoes the session settings of the insert
      batch, run when the batch failed (it may have stopped before undoing
      them itself). Empty if there is nothing to undo. }
    function GetSameBatchResetSQL: UTF8String; virtual;
    // How the key generated by an auto-increment column is fetched after an insert
    function AutoIncRetrieval: TOPAutoIncRetrieval; virtual;
    // Query that fetches the next value of a sequence, empty if not supported
    function GetSequenceNextValSQL(const aSequenceName: UTF8String): UTF8String; virtual;
    // List of auto-increment columns to return after an insert, empty if not supported
    function GetReturningClause(aMap: TOPFieldMapArray): UTF8String; virtual;

    // Keyword for the column type of true/false values
    function GetBooleanKeyword: TSQLKeyWord; virtual;
    // Keyword for the column type of binary data
    function GetBlobKeyword: TSQLKeyWord; virtual;
    // Keyword for the column type of long text
    function GetMemoKeyword: TSQLKeyWord; virtual;
    // Text added after the long text column type, empty if none
    function GetMemoSuffix: UTF8String; virtual;
    // True if FLOAT columns should be used instead of DECIMAL columns
    function NeedsFloatOverDecimal: Boolean; virtual;
    // True if the database accepts IF NOT EXISTS when creating tables
    function SupportsIfNotExists: Boolean; virtual;
    // Column types. An empty memo/blob type means: use the keyword functions above.
    function GetDateTimeTypeSQL(aKind: TOPFloatKind): UTF8String; virtual;
    // Column type for a double precision floating point number
    function GetDoubleTypeSQL: UTF8String; virtual;
    // Column type for a single precision floating point number
    function GetSingleTypeSQL: UTF8String; virtual;
    // Column type for a currency value
    function GetCurrencyTypeSQL: UTF8String; virtual;
    // Column type for a 64-bit whole number
    function GetBigIntTypeSQL: UTF8String; virtual;
    // Column type for a 32-bit whole number, empty to use the INT keyword
    function GetIntTypeSQL: UTF8String; virtual;
    // Column type for a 16-bit whole number, empty to use the SMALLINT keyword
    function GetSmallIntTypeSQL: UTF8String; virtual;
    // Column type for long text, empty to use the long text keyword
    function GetMemoTypeSQL: UTF8String; virtual;
    // Column type for binary data, empty to use the binary data keyword
    function GetBlobTypeSQL: UTF8String; virtual;
    // Column type for a string of at most aLength characters (aFixed: exactly
    // aLength), empty to use the CHAR/VARCHAR keywords
    function GetStringTypeSQL(aFixed: Boolean; aLength: Integer): UTF8String; virtual;
    // Complete definition of an auto-increment primary key column
    function GetAutoIncColumnSQL(const aQuotedName: UTF8String; aIs64Bit: Boolean): UTF8String; virtual;

    // Clause that limits the number of rows and skips the first ones; 0 or less means not set
    function GetLimitOffsetSQL(aLimit, aOffset: Integer): UTF8String; virtual;
    // LIMIT clause meaning "all rows", for dialects that need a LIMIT before OFFSET
    function GetNoLimitSQL: UTF8String; virtual;
    // OFFSET/FETCH needs an ORDER BY (SQL Server)
    function PaginationRequiresOrderBy: Boolean; virtual;
    // Text escaped for a LIKE pattern used with ESCAPE '!'
    function EscapeLikeText(const aText: UTF8String): UTF8String; virtual;

    // INSERT for a table where every column gets a default (only auto-increment
    // columns). aAutoIncColumn is the formatted auto-increment column, if any.
    function GetEmptyInsertSQL(const aTable, aAutoIncColumn: UTF8String): UTF8String; virtual;

    // The text as a quoted string for use in SQL
    function QuoteStringLiteral(const aValue: UTF8String): UTF8String; virtual;
    // A date or time written as a value for a column default
    function GetDateTimeLiteral(aKind: TOPFloatKind; aValue: TDateTime): UTF8String; virtual;

    // Longest name the database accepts, 0 for no practical limit
    function MaxIdentifierLength: Integer; virtual;

    // True if changes to tables can be undone and made together in one transaction
    function SupportsTransactionalDDL: Boolean; virtual;
    // True if the type of an existing column can be changed
    function CanAlterColumnType: Boolean; virtual;
    // True if the nullability of an existing column can be changed
    function CanAlterNullability: Boolean; virtual;

    // Reads the tables, columns, indexes and foreign keys of the database
    function IntrospectSchema(aConnection: TSQLConnection): TOPSchemaInfo; virtual;

    // The name between the quote characters of the database
    function QuoteIdentifier(const aIdentifier: UTF8String): UTF8String; virtual;
    // True if the word is a reserved word of the database
    function IsReservedWord(const aWord: UTF8String): Boolean; virtual;
    // True if aName can be used as the name of a statement parameter
    function IsValidParamName(const aName: UTF8String): Boolean; virtual;
    // The name, changed or quoted if it is a reserved word, as the reserved word setting says
    function TransformIdentifier(const aIdentifier: UTF8String): UTF8String; virtual;
    // Patterns that are never allowed in an identifier, quoted or not.
    function GetUnsafeIdentifierPatterns: TUTF8StringArray; virtual;
    // Raise EOPF if aIdentifier is empty or contains an unsafe pattern.
    procedure ValidateIdentifier(const aIdentifier: UTF8String); virtual;
    // True if aIdentifier can be used without quotes (ignoring reserved words).
    function IsRegularIdentifier(const aIdentifier: UTF8String): Boolean; virtual;
    // The single entry point for identifiers in generated SQL: validates,
    // then quotes (aForceQuote) or applies the reserved word strategy.
    // An identifier that is not regular is always quoted.
    // (No default for aForceQuote: it triggers internal error 200611031 in FPC 3.2.2)
    function FormatIdentifier(const aIdentifier: UTF8String; aForceQuote: Boolean): UTF8String; virtual;
    // FormatIdentifier for each part of a dotted name (schema.name)
    function FormatQualifiedIdentifier(const aName: UTF8String): UTF8String;
    // List of the reserved words of the database
    class function GetReservedWords: TUTF8StringArray; virtual;

    // The database dialect of this driver
    property Dialect: TSQLDialect read FDialect;
    // Character used to put quotes around names
    property QuoteChar: String read FQuoteChar write FQuoteChar;
    // What to do with names that are reserved words
    property ReservedWordStrategy: TReservedWordStrategy read FReservedWordStrategy write FReservedWordStrategy;
  end;

