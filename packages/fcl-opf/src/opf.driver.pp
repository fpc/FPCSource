function TSQLDriverSQLServer.GetLimitOffsetSQL(aLimit, aOffset: Integer): UTF8String;
begin
  // SQL Server: OFFSET M ROWS FETCH NEXT N ROWS ONLY (requires ORDER BY)
  Result:='';
  if aOffset > 0 then
    Result:='OFFSET ' + IntToStr(aOffset) + ' ROWS'
  else if aLimit > 0 then
    Result:='OFFSET 0 ROWS';
  if aLimit > 0 then
    Result:=Result + ' FETCH NEXT ' + IntToStr(aLimit) + ' ROWS ONLY';
end;

{ TSQLDriverOracle }

function TSQLDriverOracle.GetLimitOffsetSQL(aLimit, aOffset: Integer): UTF8String;
begin
  // Oracle 12c+: OFFSET M ROWS FETCH NEXT N ROWS ONLY
  Result:='';
  if aOffset > 0 then
    Result:='OFFSET ' + IntToStr(aOffset) + ' ROWS';
  if aLimit > 0 then
  begin
    if Result <> '' then
      Result:=Result + ' ';
    Result:=Result + 'FETCH NEXT ' + IntToStr(aLimit) + ' ROWS ONLY';
  end;
end;

function TSQLDriverOracle.GetSequenceNextValSQL(const aSequenceName: UTF8String): UTF8String;
begin
  Result:='SELECT '+FormatQualifiedIdentifier(aSequenceName)+'.NEXTVAL FROM DUAL';
end;

