function TSQLDriverFirebird.GetAutoIncColumnSQL(const aQuotedName: UTF8String; aIs64Bit: Boolean): UTF8String;
begin
  // Firebird before 3.0 needs a generator and a trigger, which the DDL builder does not create
  Result:='';
  raise EOPF.CreateFmt(SErrAutoIncNeedsFirebird3, [aQuotedName]);
end;

