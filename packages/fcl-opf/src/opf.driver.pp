begin
  Result:=airReturningInto;
end;

function TSQLDriverOracle.GetAutoIncColumnSQL(const aQuotedName: UTF8String; aIs64Bit: Boolean): UTF8String;
begin
  // Oracle 12c and later
  if aIs64Bit then
    Result:=aQuotedName+' NUMBER(19) GENERATED BY DEFAULT ON NULL AS IDENTITY PRIMARY KEY'
  else
    Result:=aQuotedName+' NUMBER(10) GENERATED BY DEFAULT ON NULL AS IDENTITY PRIMARY KEY';
end;

