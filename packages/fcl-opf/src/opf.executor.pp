unit Opf.Executor;

{$mode objfpc}{$H+}

interface

uses
{$IFDEF FPC_DOTTEDUNITS}
  System.Classes, System.SysUtils, System.TypInfo, Data.Db, Data.Sqldb,
{$ELSE}
  Classes, SysUtils, typinfo, db, sqldb,
{$ENDIF}
  Opf.Types, Opf.Registry, Opf.Fields, Opf.Driver, Opf.Sql, Opf.ListReg,
  Opf.Factory;

Type
  TOPExecutor = Class;
  TOPExecutorClass = Class of TOPExecutor;

  { TOPExecutor }

  TOPExecutor = Class(TOPBaseComponent)
  Private
    Class var
      _Instance : TOPExecutor;
      _InstanceClass : TOPExecutorClass;
  Private
    FUpperCaseUUID: Boolean;
    procedure ValidateExecArgs(const aMethod: string; aInstance: TObject;
      aPersister: TOPPersister; aFieldMap: TOPFieldMapList;
      const aSQL: UTF8String; aConnection: TSQLConnection);
    procedure ValidateListArgs(const aMethod: string; aList: TObject;
      aManipulator: TOPListManipulator; aClass: TClass);
    procedure CheckColumns(const aMethod: string; aQuery: TSQLQuery;
      aFieldMap: TOPFieldMapList; aBuilder: TOPSQLBuilder);
    procedure MapRowToObject(aInstance: TObject; aPersister: TOPPersister;
      aFieldMap: TOPFieldMapList; aQuery: TSQLQuery; aBuilder: TOPSQLBuilder);
    procedure MapRowsToList(aList: TObject; aManipulator: TOPListManipulator;
      aClass: TClass; aPersister: TOPPersister;
      aFieldMap: TOPFieldMapList; aQuery: TSQLQuery; aBuilder: TOPSQLBuilder;
      aContext: TOPFactoryContext = nil);
    procedure BindFieldParams(const aMethod: string; aInstance: TObject;
      aPersister: TOPPersister; aFieldMap: TOPFieldMapList; aQuery: TSQLQuery;
      aBuilder: TOPSQLBuilder; aStrict, aSkipAutoInc: Boolean);
    function DoQuerySQL(aInstance: TObject; aPersister: TOPPersister;
      aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
      aConnection: TSQLConnection; aParams: TParams; aBuilder: TOPSQLBuilder): Boolean;
    procedure DoQuerySQLList(aList: TObject; aManipulator: TOPListManipulator;
      aClass: TClass; aPersister: TOPPersister;
      aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
      aConnection: TSQLConnection; aParams: TParams; aBuilder: TOPSQLBuilder);
    // Run aBuilder.Driver.GetSameBatchResetSQL after a failed insert batch; errors are only logged
    procedure ResetAfterFailedBatch(aConnection: TSQLConnection; aBuilder: TOPSQLBuilder);
    procedure DoExecuteSQL(aInstance: TObject; aPersister: TOPPersister;
      aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
      aConnection: TSQLConnection; aBuilder: TOPSQLBuilder);
  Public
    // Frees the shared executor instance when the program ends
    Class Destructor Cleanup;
    // Sets the class used to create the shared executor instance
    Class Procedure SetInstanceClass(aClass : TOPExecutorClass);
    // Returns the shared executor instance, creating it when needed
    Class Function Instance : TOPExecutor;
    // Frees the shared executor instance
    Class Procedure ClearInstance;
    // The exception class raised for executor errors
    class function GetExceptionClass: EOPFClass; override;
    { Runs the statement on the connection, filling its parameters from the object.
      Parameter names are those of the global OPSQLBuilder, or the column names.
      A parameter in aSQL that no field fills raises EOPFExecutor. }
    procedure ExecuteSQL(aInstance: TObject; aPersister: TOPPersister;
      aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
      aConnection: TSQLConnection); virtual; overload;
    { Like ExecuteSQL, for a statement generated by aBuilder (Nil: OPSQLBuilder):
      parameter names come from aBuilder.FieldParamName. A parameter in aSQL
      that no field fills raises EOPFExecutor. }
    procedure ExecuteSQL(aInstance: TObject; aPersister: TOPPersister;
      aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
      aConnection: TSQLConnection; aBuilder: TOPSQLBuilder); virtual; overload;
    { The overloads without aBuilder use the global OPSQLBuilder for dialect
      decisions (sequences, RETURNING, post-insert ID retrieval), parameter
      names and result column names. Pass the builder that generated aSQL so
      both agree. A parameter in aSQL that no field fills raises EOPFExecutor. }
    procedure ExecuteSQLWithGeneration(aInstance: TObject; aPersister: TOPPersister;
      aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
      aConnection: TSQLConnection); virtual; overload;
    // Fills in new unique identifiers and sequence values, then runs the insert, using the given builder
    procedure ExecuteSQLWithGeneration(aInstance: TObject; aPersister: TOPPersister;
      aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
      aConnection: TSQLConnection; aBuilder: TOPSQLBuilder); virtual; overload;
    // Runs the insert and stores the database-generated key in the object (global builder)
    procedure ExecuteSQLAutoInc(aInstance: TObject; aPersister: TOPPersister;
      aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
      aConnection: TSQLConnection); virtual; overload;
    // Runs the insert and stores the database-generated key in the object; uses the given builder
    procedure ExecuteSQLAutoInc(aInstance: TObject; aPersister: TOPPersister;
      aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
      aConnection: TSQLConnection; aBuilder: TOPSQLBuilder); virtual; overload;
    { Query methods: result columns are looked up by their physical name
      (aBuilder.PhysicalName, e.g. Order_ for Order with rwsAppendChar), then by
      the mapped column name, so hand-written SQL may use either.
      The overloads without aBuilder use the global OPSQLBuilder. }
    // Runs the query and loads the first row into the object; False if no row was found
    function QuerySQL(aInstance: TObject; aPersister: TOPPersister;
      aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
      aConnection: TSQLConnection): Boolean; virtual; overload;
    // QuerySQL for a statement generated by aBuilder
    function QuerySQL(aInstance: TObject; aPersister: TOPPersister;
      aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
      aConnection: TSQLConnection; aBuilder: TOPSQLBuilder): Boolean; virtual; overload;
    // Runs the query and adds an object of class aClass to the list for each row
    procedure QuerySQLList(aList: TObject; aManipulator: TOPListManipulator;
      aClass: TClass; aPersister: TOPPersister;
      aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
      aConnection: TSQLConnection); virtual; overload;
    // QuerySQLList for a statement generated by aBuilder
    procedure QuerySQLList(aList: TObject; aManipulator: TOPListManipulator;
      aClass: TClass; aPersister: TOPPersister;
      aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
      aConnection: TSQLConnection; aBuilder: TOPSQLBuilder); virtual; overload;
    // Like QuerySQL, but with the given parameter values instead of values from the object
    function QueryCustomSQL(aInstance: TObject; aPersister: TOPPersister;
      aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
      aConnection: TSQLConnection;
      aParams: TParams): Boolean; virtual; overload;
    // QueryCustomSQL, result columns named as aBuilder names them
    function QueryCustomSQL(aInstance: TObject; aPersister: TOPPersister;
      aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
      aConnection: TSQLConnection;
      aParams: TParams; aBuilder: TOPSQLBuilder): Boolean; virtual; overload;
    // Like QuerySQLList, but with the given parameter values
    procedure QueryCustomSQLList(aList: TObject; aManipulator: TOPListManipulator;
      aClass: TClass; aPersister: TOPPersister;
      aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
      aConnection: TSQLConnection;
      aParams: TParams); virtual; overload;
    // QueryCustomSQLList, result columns named as aBuilder names them
    procedure QueryCustomSQLList(aList: TObject; aManipulator: TOPListManipulator;
      aClass: TClass; aPersister: TOPPersister;
      aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
      aConnection: TSQLConnection;
      aParams: TParams; aBuilder: TOPSQLBuilder); virtual; overload;
  Published
    { When True, generated UUIDs use uppercase hex digits (e.g. 'A1B2C3...').
      When False (default), lowercase hex digits are used (e.g. 'a1b2c3...'). }
    Property UpperCaseUUID: Boolean Read FUpperCaseUUID Write FUpperCaseUUID default False;
  end;

Function OPExecutor : TOPExecutor;

implementation

uses
{$IFDEF FPC_DOTTEDUNITS}
  Data.BufDataset,
{$ELSE}
  bufdataset,
{$ENDIF}
  Opf.Consts, Opf.Logging, Opf.FieldValue;

Resourcestring
  SErrExecutorUnboundParam = 'SQL parameter "%s" is not filled by any mapped field of %s';

{ True if the key property already has a value: not zero, not empty }

function HasKeyValue(aInstance: TObject; aField: TOPFieldMap): Boolean;
begin
  case aField.PropertyKind of
    tkInteger, tkQWord:
      Result:=GetOrdProp(aInstance, aField.PropertyName)<>0;
    tkInt64:
      Result:=GetInt64Prop(aInstance, aField.PropertyName)<>0;
    tkSString, tkAString, tkWString, tkUString:
      Result:=GetStrProp(aInstance, aField.PropertyName)<>'';
  else
    Result:=False;
  end;
end;

{ Generated key value into the key property through the persister, using a one-row dataset }

function ApplyKeyValue(aPersister: TOPPersister; aInstance: TObject; aField: TOPFieldMap; aValue: Int64): Boolean;
var
  DS: TBufDataset;
begin
  DS:=TBufDataset.Create(Nil);
  try
    DS.FieldDefs.Add('opf_ret', ftLargeint);
    DS.CreateDataset;
    DS.Append;
    DS.Fields[0].AsLargeInt:=aValue;
    DS.Post;
    Result:=aPersister.ApplyProperty(aInstance, aField, DS.Fields[0]);
  finally
    DS.Free;
  end;
end;

{ Generated key value into the key property; False when it does not fit.
  A key that is not a published property is set through the persister. }

function SetKeyValue(aPersister: TOPPersister; aInstance: TObject; aField: TOPFieldMap; aValue: Int64): Boolean;
var
  TD: PTypeData;
begin
  if GetPropInfo(aInstance, aField.PropertyName)=Nil then
    Exit(ApplyKeyValue(aPersister, aInstance, aField, aValue));
  Result:=True;
  case aField.PropertyKind of
    tkInteger:
      begin
        TD:=GetTypeData(GetPropInfo(aInstance, aField.PropertyName)^.PropType);
        if TD^.OrdType=otULong then
          Result:=(aValue>=0) and (aValue<=High(Cardinal))
        else
          Result:=(aValue>=TD^.MinValue) and (aValue<=TD^.MaxValue);
        if Result then
          SetOrdProp(aInstance, aField.PropertyName, aValue);
      end;
    tkQWord:
      begin
        Result:=aValue>=0;
        if Result then
          SetOrdProp(aInstance, aField.PropertyName, aValue);
      end;
    tkInt64:
      SetInt64Prop(aInstance, aField.PropertyName, aValue);
    tkSString, tkAString, tkWString, tkUString:
      SetStrProp(aInstance, aField.PropertyName, IntToStr(aValue));
  else
    Result:=False;
  end;
end;

{ Parameter of a mapped field: the name generated by the SQL builder,
  or the plain field name in hand-written SQL }

function FindFieldParam(aParams: TParams; aField: TOPFieldMap; aBuilder: TOPSQLBuilder): TParam;
begin
  Result:=aParams.FindParam(aBuilder.FieldParamName(aField));
  if Result=Nil then
    Result:=aParams.FindParam(aField.FieldName);
end;

{ Result column of a mapped field: the column name as the database knows it
  (reserved word strategy applied), or the mapped name in hand-written SQL }

function FindResultField(aQuery: TSQLQuery; aField: TOPFieldMap; aBuilder: TOPSQLBuilder): TField;
var
  N: UTF8String;
begin
  N:=aBuilder.PhysicalName(aField.FieldName);
  Result:=aQuery.FindField(N);
  if (Result=Nil) and (N<>aField.FieldName) then
    Result:=aQuery.FindField(aField.FieldName);
end;

function BuilderOrDefault(aBuilder: TOPSQLBuilder): TOPSQLBuilder;
begin
  Result:=aBuilder;
  if Result=Nil then
    Result:=OPSQLBuilder;
end;

Function OPExecutor : TOPExecutor;

begin
  Result:=TOPExecutor.Instance;
end;

{ TOPExecutor }

class destructor TOPExecutor.Cleanup;
begin
  ClearInstance;
end;

class procedure TOPExecutor.SetInstanceClass(aClass: TOPExecutorClass);
begin
  if Assigned(_Instance) then
    _Instance.RaiseError('SetInstanceClass', SErrExecutorCreated);
  _InstanceClass:=aClass;
end;

class function TOPExecutor.Instance: TOPExecutor;
begin
  if _Instance=Nil then
  begin
    EnterCriticalSection(OPFSingletonLock);
    try
      if _Instance=Nil then
      begin
        if _InstanceClass=Nil then
          _InstanceClass:=TOPExecutor;
        _Instance:=_InstanceClass.Create(Nil);
      end;
    finally
      LeaveCriticalSection(OPFSingletonLock);
    end;
  end;
  Result:=_Instance;
end;

class procedure TOPExecutor.ClearInstance;
begin
  FreeAndNil(_Instance);
  _InstanceClass:=Nil;
end;

class function TOPExecutor.GetExceptionClass: EOPFClass;
begin
  Result := EOPFExecutor;
end;

{ Private helpers }

procedure TOPExecutor.ValidateExecArgs(const aMethod: string; aInstance: TObject;
  aPersister: TOPPersister; aFieldMap: TOPFieldMapList;
  const aSQL: UTF8String; aConnection: TSQLConnection);
begin
  if aConnection=Nil then
    RaiseError(aMethod, SErrExecutorNilConnection);
  if aPersister=Nil then
    RaiseError(aMethod, SErrExecutorNilPersister);
  if (aFieldMap=Nil) or (aFieldMap.Count=0) then
    RaiseError(aMethod, SErrExecutorNilFieldMap);
  if aInstance=Nil then
    RaiseError(aMethod, SErrExecutorNilObject);
  if aSQL='' then
    RaiseError(aMethod, SErrExecutorEmptySQL);
  if not aConnection.Connected then
    aConnection.Open;
end;

procedure TOPExecutor.ValidateListArgs(const aMethod: string; aList: TObject;
  aManipulator: TOPListManipulator; aClass: TClass);
begin
  if aList=Nil then
    RaiseError(aMethod, SErrExecutorNilList);
  if aManipulator=Nil then
    RaiseError(aMethod, SErrExecutorNilManipulator);
  if aClass=Nil then
    RaiseError(aMethod, SErrExecutorNilClass);
end;

procedure TOPExecutor.CheckColumns(const aMethod: string; aQuery: TSQLQuery;
  aFieldMap: TOPFieldMapList; aBuilder: TOPSQLBuilder);
var
  I: Integer;
  Field: TOPFieldMap;
begin
  for I:=0 to aFieldMap.Count-1 do
  begin
    Field:=aFieldMap[I];
    if (foInSelect in Field.Options) and (FindResultField(aQuery, Field, aBuilder)=Nil) then
      RaiseError(aMethod, SErrExecutorMissingColumn, [Field.FieldName, Field.PropertyName]);
  end;
end;

procedure TOPExecutor.MapRowToObject(aInstance: TObject; aPersister: TOPPersister;
  aFieldMap: TOPFieldMapList; aQuery: TSQLQuery; aBuilder: TOPSQLBuilder);
var
  I: Integer;
  Field: TOPFieldMap;
begin
  for I:=0 to aFieldMap.Count-1 do
  begin
    Field:=aFieldMap[I];
    if foInSelect in Field.Options then
      aPersister.ApplyProperty(aInstance, Field, FindResultField(aQuery, Field, aBuilder));
  end;
end;

{ Fill the parameters of aQuery from the fields of aInstance.
  aStrict: a parameter that no field fills raises (statements: it would
  write NULL); otherwise it is logged (queries). }

procedure TOPExecutor.BindFieldParams(const aMethod: string; aInstance: TObject;
  aPersister: TOPPersister; aFieldMap: TOPFieldMapList; aQuery: TSQLQuery;
  aBuilder: TOPSQLBuilder; aStrict, aSkipAutoInc: Boolean);
var
  I: Integer;
  Field: TOPFieldMap;
  Param: TParam;
  Filled: array of Boolean;
begin
  Filled:=Nil;
  SetLength(Filled, aQuery.Params.Count);
  for I:=0 to aFieldMap.Count-1 do
  begin
    Field:=aFieldMap[I];
    if aSkipAutoInc and (foAutoInc in Field.Options) then
      Continue;
    Param:=FindFieldParam(aQuery.Params, Field, aBuilder);
    if Param<>Nil then
    begin
      aPersister.PersistProperty(aInstance, Field, Param);
      Filled[Param.Index]:=True;
    end;
  end;
  for I:=0 to aQuery.Params.Count-1 do
    // opf_ret: Oracle RETURNING ... INTO output parameter
    if not Filled[I] and not SameText(aQuery.Params[I].Name, 'opf_ret') then
    begin
      if aStrict then
        RaiseError(aMethod, SErrExecutorUnboundParam, [aQuery.Params[I].Name, aInstance.ClassName]);
      {$IFNDEF OPF_SKIP_LOGGING}
      if TOPLogger(GetLogger).IsKindActive(lkWarning) then
        TOPLogger(GetLogger).LogWarning(Self, 'SQL parameter "%s" is not filled by any field - NULL is used',
          [aQuery.Params[I].Name]);
      {$ENDIF}
    end;
end;

procedure TOPExecutor.MapRowsToList(aList: TObject; aManipulator: TOPListManipulator;
  aClass: TClass; aPersister: TOPPersister;
  aFieldMap: TOPFieldMapList; aQuery: TSQLQuery; aBuilder: TOPSQLBuilder;
  aContext: TOPFactoryContext);
var
  NewObj: TObject;
  Ctx: TOPFactoryContext;
  OwnCtx: Boolean;
begin
  OwnCtx:=aContext = nil;
  if OwnCtx then
  begin
    Ctx:=TOPFactoryContext.Create(frListItem);
    Ctx.ListObject:=aList;
  end
  else
    Ctx:=aContext;
  try
    while not aQuery.EOF do
    begin
      NewObj:=OPFactory.CreateInstance(aClass, Ctx);
      try
        MapRowToObject(NewObj, aPersister, aFieldMap, aQuery, aBuilder);
        aManipulator.AddItem(aList, NewObj);
      except
        NewObj.Free;
        raise;
      end;
      aQuery.Next;
    end;
  finally
    if OwnCtx then
      Ctx.Free;
  end;
end;

function TOPExecutor.DoQuerySQL(aInstance: TObject; aPersister: TOPPersister;
  aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
  aConnection: TSQLConnection; aParams: TParams; aBuilder: TOPSQLBuilder): Boolean;
var
  Query: TSQLQuery;
begin
  Result:=False;
  ValidateExecArgs('QuerySQL', aInstance, aPersister, aFieldMap, aSQL, aConnection);
  aBuilder:=BuilderOrDefault(aBuilder);
  Query:=TSQLQuery.Create(Nil);
  try
    Query.Database:=aConnection;
    Query.Transaction:=aConnection.Transaction;
    Query.SQL.Text:=aSQL;
    if Assigned(aParams) then
      Query.Params.Assign(aParams)
    else
      BindFieldParams('QuerySQL', aInstance, aPersister, aFieldMap, Query, aBuilder, False, False);
    try
      Query.Open;
    except
      on E: EDatabaseError do
        RaiseDBError('QuerySQL', SErrExecutorQueryFailed, [E.Message], E);
    end;
    Result:=not Query.EOF;
    CheckColumns('QuerySQL', Query, aFieldMap, aBuilder);
    if Result then
      MapRowToObject(aInstance, aPersister, aFieldMap, Query, aBuilder);
    Query.Close;
  finally
    Query.Free;
  end;
end;

procedure TOPExecutor.DoQuerySQLList(aList: TObject; aManipulator: TOPListManipulator;
  aClass: TClass; aPersister: TOPPersister;
  aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
  aConnection: TSQLConnection; aParams: TParams; aBuilder: TOPSQLBuilder);
var
  Query: TSQLQuery;
begin
  if aConnection=Nil then
    RaiseError('QuerySQLList', SErrExecutorNilConnection);
  if aPersister=Nil then
    RaiseError('QuerySQLList', SErrExecutorNilPersister);
  if (aFieldMap=Nil) or (aFieldMap.Count=0) then
    RaiseError('QuerySQLList', SErrExecutorNilFieldMap);
  ValidateListArgs('QuerySQLList', aList, aManipulator, aClass);
  if aSQL='' then
    RaiseError('QuerySQLList', SErrExecutorEmptySQL);
  if not aConnection.Connected then
    aConnection.Open;
  aBuilder:=BuilderOrDefault(aBuilder);
  Query:=TSQLQuery.Create(Nil);
  try
    Query.Database:=aConnection;
    Query.Transaction:=aConnection.Transaction;
    Query.SQL.Text:=aSQL;
    if Assigned(aParams) then
      Query.Params.Assign(aParams);
    try
      Query.Open;
    except
      on E: EDatabaseError do
        RaiseDBError('QuerySQLList', SErrExecutorQueryFailed, [E.Message], E);
    end;
    CheckColumns('QuerySQLList', Query, aFieldMap, aBuilder);
    MapRowsToList(aList, aManipulator, aClass, aPersister, aFieldMap, Query, aBuilder);
    Query.Close;
  finally
    Query.Free;
  end;
end;

procedure TOPExecutor.DoExecuteSQL(aInstance: TObject; aPersister: TOPPersister;
  aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
  aConnection: TSQLConnection; aBuilder: TOPSQLBuilder);
var
  Query: TSQLQuery;
begin
  ValidateExecArgs('ExecuteSQL', aInstance, aPersister, aFieldMap, aSQL, aConnection);
  aBuilder:=BuilderOrDefault(aBuilder);
  Query:=TSQLQuery.Create(Nil);
  try
    Query.Database:=aConnection;
    Query.Transaction:=aConnection.Transaction;
    Query.SQL.Text:=aSQL;
    BindFieldParams('ExecuteSQL', aInstance, aPersister, aFieldMap, Query, aBuilder, True, False);
    try
      Query.ExecSQL;
    except
      on E: EDatabaseError do
        RaiseDBError('ExecuteSQL', SErrExecutorExecFailed, [E.Message], E);
    end;
  finally
    Query.Free;
  end;
end;

procedure TOPExecutor.ResetAfterFailedBatch(aConnection: TSQLConnection; aBuilder: TOPSQLBuilder);
var
  ResetSQL: UTF8String;
  Query: TSQLQuery;
begin
  ResetSQL:=aBuilder.Driver.GetSameBatchResetSQL;
  if ResetSQL='' then
    Exit;
  Query:=TSQLQuery.Create(Nil);
  try
    try
      Query.Database:=aConnection;
      Query.Transaction:=aConnection.Transaction;
      Query.SQL.Text:=ResetSQL;
      Query.ExecSQL;
    except
      // The original error is what the caller needs to see
      on E: Exception do
      begin
        {$IFNDEF OPF_SKIP_LOGGING}
        if TOPLogger(GetLogger).IsKindActive(lkWarning) then
          TOPLogger(GetLogger).LogWarning(Self, 'Resetting the session after a failed insert batch failed: %s',
            [E.Message]);
        {$ENDIF}
      end;
    end;
  finally
    Query.Free;
  end;
end;

{ Public methods }

procedure TOPExecutor.ExecuteSQL(aInstance: TObject; aPersister: TOPPersister;
  aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
  aConnection: TSQLConnection);
begin
  DoExecuteSQL(aInstance, aPersister, aFieldMap, aSQL, aConnection, Nil);
end;

procedure TOPExecutor.ExecuteSQL(aInstance: TObject; aPersister: TOPPersister;
  aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
  aConnection: TSQLConnection; aBuilder: TOPSQLBuilder);
begin
  DoExecuteSQL(aInstance, aPersister, aFieldMap, aSQL, aConnection, aBuilder);
end;

procedure TOPExecutor.ExecuteSQLWithGeneration(aInstance: TObject; aPersister: TOPPersister;
  aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
  aConnection: TSQLConnection);
begin
  ExecuteSQLWithGeneration(aInstance, aPersister, aFieldMap, aSQL, aConnection, Nil);
end;

procedure TOPExecutor.ExecuteSQLWithGeneration(aInstance: TObject; aPersister: TOPPersister;
  aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
  aConnection: TSQLConnection; aBuilder: TOPSQLBuilder);
var
  I: Integer;
  Field: TOPFieldMap;
  GUID: TGUID;
  UUIDStr: String;
  SeqSQL: UTF8String;
  TD: PTypeData;
  SeqQuery: TSQLQuery;
  SeqVal: Int64;
begin
  ValidateExecArgs('ExecuteSQLWithGeneration', aInstance, aPersister, aFieldMap, aSQL, aConnection);
  if aBuilder=Nil then
    aBuilder:=OPSQLBuilder;
  // UUID generation: set values on object before INSERT
  for I:=0 to aFieldMap.Count-1 do
  begin
    Field:=aFieldMap[I];
    if (foUUID in Field.Options) and (GetStrProp(aInstance, Field.PropertyName) = '') then
    begin
      if CreateGUID(GUID) <> 0 then
        RaiseError('ExecuteSQLWithGeneration', SErrExecutorUUIDGenFailed, [Field.FieldName, aInstance.ClassName]);
      UUIDStr:=GUIDToString(GUID);
      UUIDStr:=Copy(UUIDStr, 2, Length(UUIDStr) - 2);
      if FUpperCaseUUID then
        UUIDStr:=UpperCase(UUIDStr)
      else
        UUIDStr:=LowerCase(UUIDStr);
      SetStrProp(aInstance, Field.PropertyName, UUIDStr);
    end;
  end;
  // Sequence generation: retrieve next value and set on object before INSERT
  for I:=0 to aFieldMap.Count-1 do
  begin
    Field:=aFieldMap[I];
    // A key the application already set is kept
    if (Field.SequenceName <> '') and not HasKeyValue(aInstance, Field) then
    begin
      SeqSQL:=aBuilder.GetSequenceNextValSQL(Field.SequenceName);
      if SeqSQL = '' then
        RaiseError('ExecuteSQLWithGeneration', SErrExecutorSequenceNotSupported,
          [aBuilder.SQLDialect.ToString]);
      SeqQuery:=TSQLQuery.Create(Nil);
      try
        SeqQuery.Database:=aConnection;
        SeqQuery.Transaction:=aConnection.Transaction;
        SeqQuery.SQL.Text:=SeqSQL;
        try
          SeqQuery.Open;
        except
          on E: EDatabaseError do
            RaiseDBError('ExecuteSQLWithGeneration', SErrExecutorSequenceRetrieval,
              [Field.SequenceName, aInstance.ClassName, E.Message], E);
        end;
        if SeqQuery.EOF then
          RaiseError('ExecuteSQLWithGeneration', SErrExecutorSequenceRetrieval,
            [Field.SequenceName, aInstance.ClassName, 'query returned no rows']);
        SeqVal:=SeqQuery.Fields[0].AsLargeInt;
        SeqQuery.Close;
      finally
        SeqQuery.Free;
      end;
      case Field.PropertyKind of
        tkInteger:
          begin
            // Out of range values would be truncated
            TD:=GetTypeData(GetPropInfo(aInstance, Field.PropertyName)^.PropType);
            if (TD^.OrdType=otULong) and ((SeqVal<0) or (SeqVal>High(Cardinal))) then
              RaiseError('ExecuteSQLWithGeneration', SErrExecutorSequenceRetrieval,
                [Field.SequenceName, aInstance.ClassName, Format(SErrSequenceOutOfRange, [SeqVal])])
            else if (TD^.OrdType<>otULong) and ((SeqVal<TD^.MinValue) or (SeqVal>TD^.MaxValue)) then
              RaiseError('ExecuteSQLWithGeneration', SErrExecutorSequenceRetrieval,
                [Field.SequenceName, aInstance.ClassName, Format(SErrSequenceOutOfRange, [SeqVal])]);
            SetOrdProp(aInstance, Field.PropertyName, SeqVal);
          end;
        tkQWord:
          SetOrdProp(aInstance, Field.PropertyName, OPFCheckQWord(SeqVal));
        tkInt64:
          SetInt64Prop(aInstance, Field.PropertyName, SeqVal);
        tkSString, tkAString, tkWString, tkUString:
          SetStrProp(aInstance, Field.PropertyName, IntToStr(SeqVal));
      else
        RaiseError('ExecuteSQLWithGeneration', SErrExecutorSequenceRetrieval,
          [Field.SequenceName, aInstance.ClassName, 'unsupported property type for sequence value']);
      end;
    end;
  end;
  // Custom generator: invoke callback to set value on object before INSERT
  for I:=0 to aFieldMap.Count-1 do
  begin
    Field:=aFieldMap[I];
    if Assigned(Field.OnGenerateValue) then
    begin
      try
        Field.OnGenerateValue(aInstance, Field, aConnection);
      except
        on E: Exception do
          // Keep the error code and SQL state of a database error
          RaiseDBError('ExecuteSQLWithGeneration', SErrExecutorCustomGenFailed,
            [Field.FieldName, aInstance.ClassName, E.Message], E);
      end;
    end;
  end;
  // Delegate to standard ExecuteSQL for the actual INSERT
  DoExecuteSQL(aInstance, aPersister, aFieldMap, aSQL, aConnection, aBuilder);
end;

procedure TOPExecutor.ExecuteSQLAutoInc(aInstance: TObject; aPersister: TOPPersister;
  aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
  aConnection: TSQLConnection);
begin
  ExecuteSQLAutoInc(aInstance, aPersister, aFieldMap, aSQL, aConnection, Nil);
end;

procedure TOPExecutor.ExecuteSQLAutoInc(aInstance: TObject; aPersister: TOPPersister;
  aFieldMap: TOPFieldMapList; const aSQL: UTF8String;
  aConnection: TSQLConnection; aBuilder: TOPSQLBuilder);
var
  Query: TSQLQuery;
  I, AutoIncCount: Integer;
  Field: TOPFieldMap;
  QueryField: TField;
  HasReturning: Boolean;
  PostSQL: UTF8String;
  Mode: TOPAutoIncRetrieval;
  RetParam: TParam;
begin
  ValidateExecArgs('ExecuteSQLAutoInc', aInstance, aPersister, aFieldMap, aSQL, aConnection);
  if aBuilder=Nil then
    aBuilder:=OPSQLBuilder;
  Mode:=aBuilder.Driver.AutoIncRetrieval;
  // RETURNING, or (SQL Server) a SELECT in the same batch: both give a result set
  HasReturning:=aBuilder.SupportsReturningClause or (Mode=airSameBatch);
  AutoIncCount:=0;
  for I:=0 to aFieldMap.Count-1 do
    if foAutoInc in aFieldMap[I].Options then
      Inc(AutoIncCount);
  Query:=TSQLQuery.Create(Nil);
  try
    Query.Database:=aConnection;
    Query.Transaction:=aConnection.Transaction;
    Query.SQL.Text:=aSQL;
    BindFieldParams('ExecuteSQLAutoInc', aInstance, aPersister, aFieldMap, Query, aBuilder, True, True);
    try
      if HasReturning then
      begin
        Query.Open;
        if not Query.EOF then
        begin
          for I:=0 to aFieldMap.Count-1 do
          begin
            Field:=aFieldMap[I];
            if foAutoInc in Field.Options then
            begin
              // A single returned column is unambiguous, also when the column
              // name was transformed (reserved word strategy) or case-folded.
              if (AutoIncCount=1) and (Query.Fields.Count=1) then
                QueryField:=Query.Fields[0]
              else
                QueryField:=FindResultField(Query, Field, aBuilder);
              if QueryField<>Nil then
                aPersister.ApplyProperty(aInstance, Field, QueryField);
            end;
          end;
        end
        else
          RaiseError('ExecuteSQLAutoInc', SErrExecutorAutoIncRetrieval, [aInstance.ClassName]);
        Query.Close;
      end
      else if Mode=airReturningInto then
      begin
        // Oracle: RETURNING ... INTO an output parameter
        RetParam:=Query.Params.FindParam('opf_ret');
        if RetParam=Nil then
          RaiseError('ExecuteSQLAutoInc', SErrExecutorAutoIncRetrieval, [aInstance.ClassName]);
        RetParam.ParamType:=ptOutput;
        RetParam.DataType:=ftLargeint;
        Query.ExecSQL;
        for I:=0 to aFieldMap.Count-1 do
          if foAutoInc in aFieldMap[I].Options then
          begin
            if not SetKeyValue(aPersister, aInstance, aFieldMap[I], RetParam.AsLargeInt) then
              RaiseError('ExecuteSQLAutoInc', SErrExecutorAutoIncRetrieval, [aInstance.ClassName]);
            Break;
          end;
      end
      else
      begin
        Query.ExecSQL;
        PostSQL:=aBuilder.GetPostInsertValueSQL;
        // No way to learn the generated key: do not leave it 0 silently
        if (PostSQL='') and (Mode=airNone) then
          RaiseError('ExecuteSQLAutoInc', SErrExecutorAutoIncUnsupported,
            [aInstance.ClassName, aBuilder.SQLDialect.ToString]);
        if PostSQL<>'' then
        begin
          Query.Close;
          Query.SQL.Text:=PostSQL;
          Query.Open;
          if not Query.EOF then
          begin
            for I:=0 to aFieldMap.Count-1 do
            begin
              Field:=aFieldMap[I];
              if foAutoInc in Field.Options then
              begin
                QueryField:=Query.Fields[0];
                aPersister.ApplyProperty(aInstance, Field, QueryField);
              end;
            end;
          end
          else
            RaiseError('ExecuteSQLAutoInc', SErrExecutorAutoIncRetrieval, [aInstance.ClassName]);
          Query.Close;
        end;
      end;
    except
      on E: EDatabaseError do
        if E is EOPFExecutor then
          raise
        else
        begin
          if Mode=airSameBatch then
            ResetAfterFailedBatch(aConnection, aBuilder);
          RaiseDBError('ExecuteSQLAutoInc', SErrExecutorExecFailed, [E.Message], E);
        end;
    end;
  finally
    Query.Free;
  end;
end;

