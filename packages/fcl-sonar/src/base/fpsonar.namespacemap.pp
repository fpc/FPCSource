// True iff aPlain has an entry in the active table; aDotted receives its
// dotted name.
function LookupNamespace(const aPlain: string; out aDotted: string): boolean;
// Replaces the active table with the key=value pairs read from aPath.
function LoadNamespaceMap(const aPath: string; out aError: string): boolean;
// Discards a loaded table, making the baked-in one active again.
procedure ResetNamespaceMap;

implementation

uses
{$IFDEF FPC_DOTTEDUNITS}
  System.SysUtils, System.Classes;
{$ELSE}
  SysUtils, Classes;
{$ENDIF}

var
  GLoaded: boolean;
  GLoadedMap: TNamespacePairArray;

// Byte order on Plain, then Dotted.
function ComparePairs(const aLeft, aRight: TNamespacePair): integer;

begin
  Result := CompareStr(aLeft.Plain, aRight.Plain);
  if Result = 0 then
    Result := CompareStr(aLeft.Dotted, aRight.Dotted);
end;


// In-place quicksort of aPairs[aLo..aHi] by ComparePairs.
procedure SortPairs(var aPairs: TNamespacePairArray; aLo, aHi: integer);

var
  i, j: integer;
  lPivot, lTmp: TNamespacePair;

begin
  if aLo >= aHi then
    Exit;
  i := aLo;
  j := aHi;
  lPivot := aPairs[(aLo + aHi) div 2];
  repeat
    while ComparePairs(aPairs[i], lPivot) < 0 do
      Inc(i);
    while ComparePairs(aPairs[j], lPivot) > 0 do
      Dec(j);
    if i <= j then
      begin
      lTmp := aPairs[i];
      aPairs[i] := aPairs[j];
      aPairs[j] := lTmp;
      Inc(i);
      Dec(j);
      end;
  until i > j;
  SortPairs(aPairs, aLo, j);
  SortPairs(aPairs, i, aHi);
end;


function ActiveCount: integer;

begin
  if GLoaded then
    Result := Length(GLoadedMap)
  else
    Result := Length(cNamespaceMap);
end;


function ActivePair(aIndex: integer): TNamespacePair;

begin
  if GLoaded then
    Result := GLoadedMap[aIndex]
  else
    Result := cNamespaceMap[aIndex];
end;


function LookupNamespace(const aPlain: string; out aDotted: string): boolean;

var
  lKey: string;
  lLo, lHi, lMid, lCmp: integer;

begin
  Result := False;
  aDotted := '';
  lKey := LowerCase(aPlain);
  lLo := 0;
  lHi := ActiveCount - 1;
  while lLo <= lHi do
    begin
    lMid := (lLo + lHi) div 2;
    lCmp := CompareStr(ActivePair(lMid).Plain, lKey);
    if lCmp = 0 then
      begin
      aDotted := ActivePair(lMid).Dotted;
      Result := True;
      Exit;
      end
    else if lCmp < 0 then
      lLo := lMid + 1
    else
      lHi := lMid - 1;
    end;
end;


function LoadNamespaceMap(const aPath: string; out aError: string): boolean;

var
  lLines: TStringList;
  lPairs: TNamespacePairArray;
  lLine, lKey, lValue: string;
  i, j, lCount, lKept, lSep: integer;

begin
  Result := False;
  aError := '';
  if not FileExists(aPath) then
    begin
    aError := Format('namespace map %s not found', [aPath]);
    Exit;
    end;
  lLines := TStringList.Create;
  try
    try
      lLines.LoadFromFile(aPath);
    except
      on E: Exception do
        begin
        aError := Format('cannot read namespace map %s: %s', [aPath, E.Message]);
        Exit;
        end;
    end;
    SetLength(lPairs, lLines.Count);
    lCount := 0;
    for i := 0 to lLines.Count - 1 do
      begin
      lLine := Trim(lLines[i]);
      if (lLine = '') or (lLine[1] = '#') then
        Continue;
      lKey := '';
      lValue := '';
      lSep := Pos('=', lLine);
      if lSep > 0 then
        begin
        lKey := LowerCase(Trim(Copy(lLine, 1, lSep - 1)));
        lValue := Trim(Copy(lLine, lSep + 1, Length(lLine) - lSep));
        end;
      if (lKey = '') or (lValue = '') then
        begin
        aError := Format('namespace map %s line %d: expected key=value',
          [aPath, i + 1]);
        Exit;
        end;
      lPairs[lCount].Plain := lKey;
      lPairs[lCount].Dotted := lValue;
      Inc(lCount);
      end;
    if lCount = 0 then
      begin
      aError := Format('namespace map %s holds no entries', [aPath]);
      Exit;
      end;
    SetLength(lPairs, lCount);
    SortPairs(lPairs, 0, High(lPairs));
    // Identical duplicates collapse; a key with two distinct values is dropped.
    lKept := 0;
    i := 0;
    while i <= High(lPairs) do
      begin
      j := i;
      while (j < High(lPairs)) and (lPairs[j + 1].Plain = lPairs[i].Plain) do
        Inc(j);
      if lPairs[i].Dotted = lPairs[j].Dotted then
        begin
        lPairs[lKept] := lPairs[i];
        Inc(lKept);
        end;
      i := j + 1;
      end;
    SetLength(lPairs, lKept);
    GLoadedMap := lPairs;
    GLoaded := True;
    Result := True;
  finally
    lLines.Free;
  end;
end;


procedure ResetNamespaceMap;

begin
  SetLength(GLoadedMap, 0);
  GLoaded := False;
end;


end.
