# plain
fill=color(#000000ff) fill-opacity=1 fill-rule=nonzero
stroke=none stroke-opacity=1 width=3 cap=butt join=miter miter-limit=4
opacity=1 color=#000000ff display=inline visibility=visible
font-family="" font-size=16 clip-rule=nonzero
overflow=hidden clip=auto clip-path="" mask=""
stop-color=#000000ff stop-opacity=1
color-interpolation=sRGB
text-anchor=start font-weight=400 font-style=normal font-stretch=normal font-variant=normal letter-spacing=0 word-spacing=0
writing-mode=lr-tb glyph-orientation-vertical=auto
