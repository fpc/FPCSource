{ CkSumUpdate/CkSumFinal of the crc unit against values of the POSIX cksum utility }
program tcksum;

{$mode objfpc}
{$h+}

uses
  sysutils,
  crc;

var
  lErrors: Integer;


{ Reports a failed check }
procedure Check(aCondition: Boolean; const aMsg: string);

begin
  if not aCondition then
    begin
      writeln('FAIL: ', aMsg);
      Inc(lErrors);
    end;
end;


{ Returns the cksum value of aLen bytes at aBuf in a single update }
function CkSum(aBuf: PByte; aLen: Cardinal): Cardinal;

begin
  Result:=CkSumFinal(CkSumUpdate(0, aBuf, aLen), aLen);
end;


{ Checks the cksum value of a string }
procedure CheckString(const aData: RawByteString; aExpected: Cardinal);

var
  lCrc: Cardinal;

begin
  lCrc:=CkSum(PByte(PAnsiChar(aData)), Length(aData));
  Check(lCrc=aExpected, 'cksum of '''+aData+''' is '+IntToStr(aExpected)+', got '+IntToStr(lCrc));
end;


{ Returns aLen bytes, byte i = (i*aMul+aAdd) and $ff }
function MakeData(aLen, aMul, aAdd: Cardinal): TBytes;

var
  i: Cardinal;

begin
  Result:=nil;
  SetLength(Result, aLen);
  for i:=0 to aLen-1 do
    Result[i]:=Byte((i*aMul+aAdd) and $ff);
end;


{ Checks the cksum value of generated data in one update and in three chained updates }
procedure CheckData(aLen, aMul, aAdd, aExpected: Cardinal);

var
  lData: TBytes;
  lCrc: Cardinal;
  lName: string;

begin
  lData:=MakeData(aLen, aMul, aAdd);
  lName:=IntToStr(aLen)+' generated bytes';
  lCrc:=CkSum(@lData[0], aLen);
  Check(lCrc=aExpected, 'cksum of '+lName+' is '+IntToStr(aExpected)+', got '+IntToStr(lCrc));
  lCrc:=CkSumUpdate(0, @lData[0], 1);
  lCrc:=CkSumUpdate(lCrc, @lData[1], aLen div 2);
  lCrc:=CkSumUpdate(lCrc, @lData[1+aLen div 2], aLen-1-aLen div 2);
  lCrc:=CkSumFinal(lCrc, aLen);
  Check(lCrc=aExpected, 'chained cksum of '+lName+' is '+IntToStr(aExpected)+', got '+IntToStr(lCrc));
end;


{ Checks the exported table against the polynomial }
procedure CheckTable;

var
  lTable: PCardinal;

begin
  lTable:=get_cksum_table;
  Check(lTable[0]=0, 'Table entry 0 is 0');
  Check(lTable[1]=$04C11DB7, 'Table entry 1 is the polynomial $04C11DB7');
  Check(lTable[255]=$B1F740B4, 'Table entry 255 is $B1F740B4');
end;


begin
  lErrors:=0;
  CheckString('', 4294967295);
  CheckString('a', 1220704766);
  CheckString('123456789', 930766865);
  CheckString('The quick brown fox jumps over the lazy dog', 2074844392);
  Check(CkSumUpdate(0, nil, 0)=0, 'Update without data returns the CRC unchanged');
  Check(CkSumFinal(0, 0)=4294967295, 'cksum of no data is 4294967295');
  CheckData(256, 1, 0, 1313719201);
  CheckData(70000, 7, 3, 396058721);
  CheckData((1 shl 24)+3, 13, $5a, 331774478);
  CheckTable;
  if lErrors>0 then
    begin
      writeln(lErrors, ' errors');
      Halt(1);
    end;
  writeln('ok');
end.
