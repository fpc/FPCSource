<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="13"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="Pascal to Javascript converter tests"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <i18n>
      <EnableI18N LFM="False"/>
    </i18n>
    <BuildModes>
      <Item Name="default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
      <Modes>
        <Mode Name="default"/>
      </Modes>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="FPCUnitConsoleRunner"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="testpas2js.pp"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="../src/fppas2js.pp"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="FPPas2Js"/>
      </Unit>
      <Unit>
        <Filename Value="tcmodules.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TCModules"/>
      </Unit>
      <Unit>
        <Filename Value="tcoptimizations.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TCOptimizations"/>
      </Unit>
      <Unit>
        <Filename Value="tcsrcmap.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TCSrcMap"/>
      </Unit>
      <Unit>
        <Filename Value="../src/fppjssrcmap.pp"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="FPPJsSrcMap"/>
      </Unit>
      <Unit>
        <Filename Value="tcfiler.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TCFiler"/>
      </Unit>
      <Unit>
        <Filename Value="../src/pas2jsfiler.pp"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Pas2JsFiler"/>
      </Unit>
      <Unit>
        <Filename Value="tcunitsearch.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TCUnitSearch"/>
      </Unit>
      <Unit>
        <Filename Value="tcprecompile.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TCPrecompile"/>
      </Unit>
      <Unit>
        <Filename Value="../src/pas2jsuseanalyzer.pp"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Pas2jsUseAnalyzer"/>
      </Unit>
      <Unit>
        <Filename Value="tcgenerics.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TCGenerics"/>
      </Unit>
      <Unit>
        <Filename Value="tcconverter.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="tcpas2jsanalyzer.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TCPas2JSAnalyzer"/>
      </Unit>
      <Unit>
        <Filename Value="tcoperatoroverload.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TCOperatorOverload"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="testpas2js"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="../src;../../fcl-js/src;../../fcl-json/src;../../fcl-passrc/src;../../pastojs/tests"/>
      <UnitOutputDirectory Value="lib"/>
    </SearchPaths>
    <CodeGeneration>
      <Checks>
        <IOChecks Value="True"/>
        <RangeChecks Value="True"/>
        <OverflowChecks Value="True"/>
        <StackChecks Value="True"/>
      </Checks>
      <VerifyObjMethodCallValidity Value="True"/>
    </CodeGeneration>
    <Other>
      <CustomOptions Value="-dVerbosePas2JS"/>
      <OtherDefines Count="1">
        <Define0 Value="VerbosePas2JS"/>
      </OtherDefines>
    </Other>
  </CompilerOptions>
  <Debugging>
    <Exceptions>
      <Item>
        <Name Value="EAbort"/>
      </Item>
      <Item>
        <Name Value="ECodetoolError"/>
      </Item>
      <Item>
        <Name Value="EFOpenError"/>
      </Item>
    </Exceptions>
  </Debugging>
</CONFIG>
