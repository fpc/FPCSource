type
  // Returns the address of the OpenGL entry point aName, or nil.
  TGLCoreGetProcAddress = function(aName: PAnsiChar): Pointer;

// Loads the OpenGL library aLibName, or the default OpenGL library of the platform when aLibName is empty.
function glcorearb_LoadLibrary(const aLibName: AnsiString = ''): Boolean;
// Unloads the library loaded by glcorearb_LoadLibrary.
procedure glcorearb_FreeLibrary;
// Returns the address of the entry point aName in the loaded OpenGL library, or nil.
function glcorearb_GetProcAddress(aName: PAnsiChar): Pointer;
// Resolves all entry points through aGetProcAddress, or through glcorearb_GetProcAddress when it is nil.
// Needs a current context. A resolved entry point is not proof of support: check the version or extension.
// Returns false when glGetString, glGetIntegerv or glGetStringi cannot be resolved.
function Load_GL_CORE(aGetProcAddress: TGLCoreGetProcAddress = nil): Boolean;
// Sets all entry points to nil.
procedure Free_GL_CORE;
// Returns whether the OpenGL version of the current context is at least aMajor.aMinor.
function glcorearb_VersionSupported(aMajor, aMinor: Integer): Boolean;
// Returns whether the current context supports the extension aName.
function glcorearb_ExtensionSupported(const aName: AnsiString): Boolean;

