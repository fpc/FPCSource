{$IF defined(Windows)}
  DefaultLibName = 'opengl32.dll';
  PlatformGetProcName = 'wglGetProcAddress';
{$ELSEIF defined(OS2)}
  DefaultLibName = 'opengl.dll';
  PlatformGetProcName = '';
{$ELSEIF defined(darwin)}
  DefaultLibName = '/System/Library/Frameworks/OpenGL.framework/Libraries/libGL.dylib';
  PlatformGetProcName = '';
{$ELSEIF defined(haiku) or defined(OpenBSD) or defined(NetBSD)}
  DefaultLibName = 'libGL.so';
  PlatformGetProcName = 'glXGetProcAddressARB';
{$ELSE}
  DefaultLibName = 'libGL.so.1';
  PlatformGetProcName = 'glXGetProcAddressARB';
{$ENDIF}

type
  TPlatformGetProcAddress = function(aName: PAnsiChar): Pointer; extdecl;

var
  LibGLCore: TLibHandle = NilHandle;
  PlatformGetProcAddress: TPlatformGetProcAddress = nil;


function glcorearb_LoadLibrary(const aLibName: AnsiString): Boolean;

var
  lName: AnsiString;

begin
  if LibGLCore<>NilHandle then
    Exit(True);
  lName:=aLibName;
  if lName='' then
    lName:=DefaultLibName;
  LibGLCore:=LoadLibrary(lName);
  Result:=LibGLCore<>NilHandle;
  if Result and (PlatformGetProcName<>'') then
    Pointer(PlatformGetProcAddress):=GetProcAddress(LibGLCore,PlatformGetProcName);
end;


procedure glcorearb_FreeLibrary;

begin
  PlatformGetProcAddress:=nil;
  if LibGLCore<>NilHandle then
    FreeLibrary(LibGLCore);
  LibGLCore:=NilHandle;
end;


function glcorearb_GetProcAddress(aName: PAnsiChar): Pointer;

begin
  Result:=nil;
  if LibGLCore=NilHandle then
    Exit;
{$IFDEF Windows}
  if Assigned(PlatformGetProcAddress) then
    Result:=PlatformGetProcAddress(aName);
  // 1, 2, 3 and -1 are failure results of wglGetProcAddress
  if (PtrUInt(Result)<=3) or (PtrUInt(Result)=High(PtrUInt)) then
    Result:=GetProcAddress(LibGLCore,aName);
{$ELSE}
  Result:=GetProcAddress(LibGLCore,aName);
  if (Result=nil) and Assigned(PlatformGetProcAddress) then
    Result:=PlatformGetProcAddress(aName);
{$ENDIF}
end;



