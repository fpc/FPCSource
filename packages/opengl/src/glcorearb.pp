function Load_GL_CORE(aGetProcAddress: TGLCoreGetProcAddress): Boolean;

begin
  if not Assigned(aGetProcAddress) then
    begin
    if not glcorearb_LoadLibrary('') then
      Exit(False);
    aGetProcAddress:=@glcorearb_GetProcAddress;
    end;
  LoadEntryPoints(aGetProcAddress);
  Result:=Assigned(glGetString) and Assigned(glGetIntegerv) and Assigned(glGetStringi);
end;


procedure Free_GL_CORE;

begin
  ClearEntryPoints;
end;


function glcorearb_VersionSupported(aMajor, aMinor: Integer): Boolean;

var
  lMajor, lMinor: GLint;

begin
  Result:=False;
  if not Assigned(glGetIntegerv) then
    Exit;
  lMajor:=0;
  lMinor:=0;
  glGetIntegerv(GL_MAJOR_VERSION,@lMajor);
  glGetIntegerv(GL_MINOR_VERSION,@lMinor);
  Result:=(lMajor>aMajor) or ((lMajor=aMajor) and (lMinor>=aMinor));
end;


function glcorearb_ExtensionSupported(const aName: AnsiString): Boolean;

var
  lCount: GLint;
  lIndex: Integer;

begin
  Result:=False;
  if not (Assigned(glGetIntegerv) and Assigned(glGetStringi)) then
    Exit;
  lCount:=0;
  glGetIntegerv(GL_NUM_EXTENSIONS,@lCount);
  for lIndex:=0 to lCount-1 do
    if AnsiString(PAnsiChar(glGetStringi(GL_EXTENSIONS,lIndex)))=aName then
      Exit(True);
end;


initialization
  {$IF defined(cpui386) or defined(cpux86_64)}
  SetExceptionMask([exInvalidOp,exDenormalized,exZeroDivide,exOverflow,exUnderflow,exPrecision]);
  {$ENDIF}
finalization
  Free_GL_CORE;
  glcorearb_FreeLibrary;
end.
