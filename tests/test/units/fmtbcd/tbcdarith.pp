var
  Failures: Integer = 0;
  Checks: Integer = 0;

// Records the result of a check
procedure Check(aCondition: Boolean; const aMsg: String);

begin
  Inc(Checks);
  if not aCondition then
    begin
    Inc(Failures);
    if Failures<=30 then
      Writeln('FAIL: ',aMsg);
    end;
end;


// Returns aValue with aExtra trailing zero places added, or aValue if it does not fit
function Padded(const aValue: TBCD; aExtra: Integer): TBCD;

begin
  Result:=aValue;
  if (BCDPrecision(aValue)+aExtra<=64) and (BCDScale(aValue)+aExtra<=63) then
    NormalizeBCD(aValue,Result,BCDPrecision(aValue)+aExtra,BCDScale(aValue)+aExtra);
end;


// Returns the sign of aValue: -1, 0 or 1
function Sign(aValue: Integer): Integer;

begin
  if aValue<0 then
    Result:=-1
  else if aValue>0 then
    Result:=1
  else
    Result:=0;
end;


// Checks BCDCompare and the comparison operators of aLeft and aRight against aExpected
procedure CheckCompare(const aName: String; const aLeft, aRight: TBCD; aExpected: Integer);

var
  lRes: Integer;

begin
  lRes:=Sign(BCDCompare(aLeft,aRight));
  Check(lRes=aExpected,aName+': BCDCompare('+BCDToStr(aLeft)+', '+BCDToStr(aRight)+') = '+IntToStr(lRes)
    +', expected '+IntToStr(aExpected));
  Check((aLeft=aRight)=(aExpected=0),aName+': operator = gives '+BoolToStr(aLeft=aRight,True));
  Check((aLeft<>aRight)=(aExpected<>0),aName+': operator <> gives '+BoolToStr(aLeft<>aRight,True));
  Check((aLeft<aRight)=(aExpected<0),aName+': operator < gives '+BoolToStr(aLeft<aRight,True));
  Check((aLeft>aRight)=(aExpected>0),aName+': operator > gives '+BoolToStr(aLeft>aRight,True));
  Check((aLeft<=aRight)=(aExpected<=0),aName+': operator <= gives '+BoolToStr(aLeft<=aRight,True));
  Check((aLeft>=aRight)=(aExpected>=0),aName+': operator >= gives '+BoolToStr(aLeft>=aRight,True));
end;


// Runs one arithmetic case on aA and aB and checks the result text
procedure CheckArith(const aName: String; const aCase: TCase; const aA, aB: TBCD);

var
  lRes: TBCD;
  lText: String;

begin
  try
    case aCase.Op of
      '+': lRes:=aA+aB;
      '-': lRes:=aA-aB;
      '*': lRes:=aA*aB;
      '/': lRes:=aA/aB;
    end;
    lText:=BCDToStr(lRes);
  except
    on E: eBCDOverflowException do
      lText:='overflow';
    on E: Exception do
      lText:=E.ClassName+': '+E.Message;
  end;
  Check(lText=aCase.Expected,aName+': '+aCase.A+' '+aCase.Op+' '+aCase.B+' = '+lText+', expected '+aCase.Expected);
end;


// Runs the precomputed cases, also with operands that have extra trailing zeros
procedure TestCases;

var
  I: Integer;
  lA, lB: TBCD;

begin
  for I:=Low(cCases) to High(cCases) do
    with cCases[I] do
      begin
      lA:=StrToBCD(A);
      lB:=StrToBCD(B);
      if Op='c' then
        begin
        CheckCompare('case '+IntToStr(I),lA,lB,StrToInt(Expected));
        CheckCompare('case '+IntToStr(I)+' padded left',Padded(lA,3),lB,StrToInt(Expected));
        CheckCompare('case '+IntToStr(I)+' padded right',lA,Padded(lB,5),StrToInt(Expected));
        end
      else
        begin
        CheckArith('case '+IntToStr(I),cCases[I],lA,lB);
        if Op='/' then
          CheckArith('case '+IntToStr(I)+' padded',cCases[I],Padded(lA,2),Padded(lB,4));
        end;
      end;
end;


// Representations of zero: division, comparison and zero dividend
procedure TestZero;

const
  cCount = 8;

var
  lZero: array[1..cCount] of TBCD;
  lValue, lRes: TBCD;
  I, J: Integer;
  lRaised: Boolean;

begin
  lZero[1]:=NullBCD;
  lZero[2]:=StrToBCD('0');
  lZero[3]:=StrToBCD('0.000');
  lZero[4]:=IntegerToBCD(0);
  lZero[5]:=CurrToBCD(0);
  lZero[6]:=DoubleToBCD(0);
  lZero[7]:=IntegerToBCD(0);
  BCDNegate(lZero[7]);
  NormalizeBCD(StrToBCD('0'),lZero[8],10,5);
  lValue:=StrToBCD('12.5');
  for I:=1 to cCount do
    begin
    lRaised:=False;
    try
      lRes:=lValue/lZero[I];
    except
      on E: eBCDException do
        lRaised:=E.Message='Division by zero';
    end;
    Check(lRaised,'zero form '+IntToStr(I)+': 12.5 / zero raises division by zero');
    lRes:=lZero[I]/lValue;
    Check(BCDToStr(lRes)='0','zero form '+IntToStr(I)+': zero / 12.5 = '+BCDToStr(lRes));
    CheckCompare('zero form '+IntToStr(I)+' with 1',lZero[I],StrToBCD('1'),-1);
    CheckCompare('zero form '+IntToStr(I)+' with -1',lZero[I],StrToBCD('-1'),1);
    CheckCompare('zero form '+IntToStr(I)+' with 0.0001',lZero[I],StrToBCD('0.0001'),-1);
    for J:=1 to cCount do
      CheckCompare('zero forms '+IntToStr(I)+' and '+IntToStr(J),lZero[I],lZero[J],0);
    end;
end;


// Equal values with different representations, and ordering across representations
procedure TestRepresentations;

const
  cForms = 5;

var
  lForms: array[0..High(cOrdered),1..cForms] of TBCD;
  lHas: array[0..High(cOrdered),1..cForms] of Boolean;
  lValue: TBCD;
  lCurr: Currency;
  lDouble: Double;
  I, J, F, G: Integer;

begin
  for I:=0 to High(cOrdered) do
    begin
    lValue:=StrToBCD(cOrdered[I]);
    lForms[I,1]:=lValue;
    lHas[I,1]:=True;
    lForms[I,2]:=Padded(lValue,4);
    lHas[I,2]:=True;
    lHas[I,3]:=TryStrToCurr(cOrdered[I],lCurr,DefaultFormatSettings) and (Abs(lCurr)<1e14);
    if lHas[I,3] then
      lForms[I,3]:=CurrToBCD(lCurr);
    lHas[I,4]:=Pos('.',cOrdered[I])=0;
    if lHas[I,4] then
      lForms[I,4]:=IntegerToBCD(StrToInt64(cOrdered[I]));
    lDouble:=StrToFloat(cOrdered[I],DefaultFormatSettings);
    lHas[I,5]:=Frac(lDouble*8)=0;
    if lHas[I,5] then
      lForms[I,5]:=DoubleToBCD(lDouble);
    end;
  for I:=0 to High(cOrdered) do
    for J:=0 to High(cOrdered) do
      for F:=1 to cForms do
        for G:=1 to cForms do
          if lHas[I,F] and lHas[J,G] then
            CheckCompare(cOrdered[I]+' form '+IntToStr(F)+' and '+cOrdered[J]+' form '+IntToStr(G),
              lForms[I,F],lForms[J,G],Sign(I-J));
end;


// Conversions between QWord and BCD
procedure TestQWord;

const
  cValues: array[0..8] of QWord = (0, 1, 9, 10, 1000000000000000000, QWord(High(Int64)),
    QWord(High(Int64))+1, 10000000000000000000, High(QWord));
  cTexts: array[0..8] of String = ('0', '1', '9', '10', '1000000000000000000', '9223372036854775807',
    '9223372036854775808', '10000000000000000000', '18446744073709551615');

var
  I: Integer;
  lBCD: TBCD;
  lQ: QWord;
  lRaised: Boolean;

  // Returns True if converting aText to QWord raises an overflow
  function RaisesOverflow(const aText: String): Boolean;

  begin
    Result:=False;
    try
      lQ:=StrToBCD(aText);
    except
      on E: eBCDOverflowException do
        Result:=True;
    end;
  end;

begin
  for I:=Low(cValues) to High(cValues) do
    begin
    lBCD:=cValues[I];
    Check(BCDToStr(lBCD)=cTexts[I],'QWord '+cTexts[I]+' to BCD gives '+BCDToStr(lBCD));
    lRaised:=False;
    try
      lQ:=StrToBCD(cTexts[I]);
    except
      on E: Exception do
        lRaised:=True;
    end;
    Check(not lRaised and (lQ=cValues[I]),'BCD '+cTexts[I]+' to QWord gives '+IntToStr(lQ));
    end;
  lQ:=StrToBCD('123.4');
  Check(lQ=123,'BCD 123.4 to QWord gives '+IntToStr(lQ));
  lQ:=StrToBCD('123.5');
  Check(lQ=124,'BCD 123.5 to QWord gives '+IntToStr(lQ));
  Check(RaisesOverflow('18446744073709551616'),'BCD 18446744073709551616 to QWord raises an overflow');
  Check(RaisesOverflow('100000000000000000000'),'BCD 1E20 to QWord raises an overflow');
  Check(RaisesOverflow('1'+StringOfChar('0',40)),'BCD 1E40 to QWord raises an overflow');
  Check(RaisesOverflow('-9223372036854775809'),'BCD below Low(Int64) to QWord raises an overflow');
end;


begin
  DefaultFormatSettings.DecimalSeparator:='.';
  DefaultFormatSettings.ThousandSeparator:=',';
  TestCases;
  TestZero;
  TestRepresentations;
  TestQWord;
  if Failures>0 then
    begin
    Writeln(Failures,' of ',Checks,' checks failed');
    Halt(1);
    end;
  Writeln('ok, ',Checks,' checks');
end.
